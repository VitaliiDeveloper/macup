cleanup_lang(){ [ -n "$LANGFILE" ] && rm -f "$LANGFILE"; }
trap cleanup_lang EXIT
set_lang(){ case "$1" in en|uk|ru) MSG_LANG=$1 ;; ua) MSG_LANG=uk ;; *) echo "--lang: en | uk | ru"; exit 2 ;; esac; load_lang; }
while [ $# -gt 0 ]; do case "$1" in
  check|-n|--dry-run)   DRY=1; ACTION=check ;;
  all|run)              ACTION=all ;;
  update|--no-clean)    DO_CLEAN=0; ACTION=update ;;
  clean|--no-update)    DO_UPDATE=0; ACTION=clean ;;
  deep|--deep)          DEEP=1 ;;
  --skip)               CLI_SKIP="$CLI_SKIP,$2"; shift ;;
  --skip=*)             CLI_SKIP="$CLI_SKIP,${1#*=}" ;;
  --only)               CLI_ONLY="$CLI_ONLY,$2"; shift ;;
  --only=*)             CLI_ONLY="$CLI_ONLY,${1#*=}" ;;
  --level)              LEVEL=$(level_num "$2"); [ -z "$LEVEL" ] && { echo "--level: safe | standard | aggressive"; exit 2; }; shift ;;
  --level=*)            LEVEL=$(level_num "${1#*=}"); [ -z "$LEVEL" ] && { echo "--level: safe | standard | aggressive"; exit 2; } ;;
  --lang)               set_lang "$2"; shift ;;
  --lang=*)             set_lang "${1#*=}" ;;
  --no-color)           B=; G=; Y=; R=; C=; D=; N=; CL= ;;
  -y|--yes)             YES=1 ;;
  lang|language)        CMD=lang; case "${2:-}" in ""|-*) ;; *) LANG_ARG=$2; shift ;; esac ;;
  last|--last)          CMD=last ;;
  history|--history)    CMD=history ;;
  reports|--reports)    CMD=reports ;;
  tasks|--tasks)        CMD=tasks ;;
  config|--config)      CMD=config ;;
  self-update|selfupdate|upgrade) CMD=self_update ;;
  uninstall)            CMD=uninstall ;;
  help|-h|--help)       CMD=help ;;
  version|-v|--version) CMD=version ;;
  *) _f 'Unknown command: %s' "$1"; echo; _ 'Type  macup  for the menu or  macup help  for all commands.'; echo; exit 1 ;;
esac; shift; done

# one-off commands run after all options are read, so `macup help --lang uk` works
case "$CMD" in
  lang)        choose_lang "$LANG_ARG"; exit $? ;;
  last)        show_last; exit 0 ;;
  history)     show_history; exit 0 ;;
  reports)     mkdir -p "$LOGDIR"; open "$LOGDIR"; exit 0 ;;
  tasks)       list_tasks; exit 0 ;;
  config)      open_conf; exit 0 ;;
  self_update) self_update; exit 0 ;;
  uninstall)   uninstall; exit 0 ;;
  help)        usage; exit 0 ;;
  version)     echo "macup $MACUP_VERSION"; exit 0 ;;
esac

# Changing anything needs an explicit command (all, update, clean). Without one:
# a terminal gets the menu, `macup --deep` is a deep check, anything else gets the help.
if [ -z "$ACTION" ]; then
  if [ "$DEEP" = 1 ]; then DRY=1
  elif [ -t 0 ] && [ -t 1 ]; then menu
  else usage; exit 2; fi
fi

load_conf
mkdir -p "$LOGDIR" "$STATE_DIR"
STAMP=$(date +%Y-%m-%d_%H-%M)
REPORT="$LOGDIR/macup_$STAMP.md"
RAW="$LOGDIR/macup_$STAMP.log"
BODY=$(mktemp "${TMPDIR:-/tmp}/macup.XXXXXX")
# the cleaners keep lists in $BODY.rt and $BODY.caches while they run
cleanup_body(){ [ -n "$BODY" ] && rm -f "$BODY" "$BODY.rt" "$BODY.caches"; }
trap '[ -n "$TICK" ] && kill "$TICK" 2>/dev/null; printf "\n%s%s%s\n" "$Y" "$(_f "Interrupted. Log: %s" "$(tildify "$RAW")")" "$N"; cleanup_body; cleanup_lang; exit 130' INT
trap 'cleanup_body; cleanup_lang' EXIT

if [ "$DRY" = 1 ]; then MODE="check"; elif [ "$DO_UPDATE" = 0 ]; then MODE="clean"; elif [ "$DO_CLEAN" = 0 ]; then MODE="update"; else MODE="all"; fi
[ "$DEEP" = 1 ] && MODE="$MODE+deep"
printf '%smacup %s%s · %s%s\n' "$B" "$MACUP_VERSION" "$N" "$MODE" "$( [ "$DRY" = 1 ] && printf ' · %s' "$(_ 'nothing is installed or deleted unless you pick it')")"

PREV=$( [ -s "$HISTORY" ] && tail -n 1 "$HISTORY")

# ================================================================ SYSTEM
section "System"
OSV=$(sw_vers -productVersion 2>/dev/null)
if task check.system; then
  UPTXT=$(uptime | sed -E 's/.* up ([^,]+(, *[0-9]+:[0-9]+)?),.*/\1/')
  BOOT=$(sysctl -n kern.boottime 2>/dev/null | awk -F'sec = ' '{print $2+0}')
  UPDAYS=$(( ( $(date +%s) - ${BOOT:-$(date +%s)} ) / 86400 ))
  BUILD=$(sw_vers -buildVersion 2>/dev/null); MODEL=$(sysctl -n hw.model 2>/dev/null)
  if [ "$UPDAYS" -ge 14 ]; then warn 'macOS %s (%s) · %s · up %s — restart recommended (%s days without restart)' "$OSV" "$BUILD" "$MODEL" "$UPTXT" "$UPDAYS"
  else ok 'macOS %s (%s) · %s · up %s' "$OSV" "$BUILD" "$MODEL" "$UPTXT"; fi
fi

D_TOTAL=$(df -k /System/Volumes/Data 2>/dev/null | awk 'NR==2{print $2}'); D_TOTAL=${D_TOTAL:-1}
FREE_BEFORE=$(df -k /System/Volumes/Data 2>/dev/null | awk 'NR==2{print $4}'); FREE_BEFORE=${FREE_BEFORE:-0}
if task check.disk; then
  PCT=$(( FREE_BEFORE * 100 / D_TOTAL )); F1=$(hum "$FREE_BEFORE"); F2=$(hum "$D_TOTAL")
  if   [ "$PCT" -lt 10 ]; then fail 'Disk: %s free of %s (%s%%) — critically low' "$F1" "$F2" "$PCT"
  elif [ "$PCT" -lt 20 ]; then warn 'Disk: %s free of %s (%s%%) — getting low' "$F1" "$F2" "$PCT"
  else ok 'Disk: %s free of %s (%s%%)' "$F1" "$F2" "$PCT"; fi
  SWAPDISK=$(df -k /System/Volumes/VM 2>/dev/null | awk 'NR==2{print $3}')
  [ "${SWAPDISK:-0}" -ge 1048576 ] && info 'Swap files: %s of the used space (macOS removes them on restart)' "$(hum "$SWAPDISK")"
  SMART=$(diskutil info disk0 2>/dev/null | awk -F': *' '/SMART Status/{print $2}')
  if [ -n "$SMART" ]; then
    case "$SMART" in Verified|"Not Supported") ok 'Disk health (SMART): %s' "$SMART" ;; *) fail 'Disk health (SMART): %s — back up now' "$SMART" ;; esac
  fi
  SNAPS=$(tmutil listlocalsnapshots / 2>/dev/null | grep -c 'com.apple')
  [ "${SNAPS:-0}" -gt 0 ] && info 'Local Time Machine snapshots: %s (macOS frees them automatically when space runs low)' "$SNAPS"
fi

MEMFREE=""; SWAP=0
if task check.memory; then
  RAM=$(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1073741824 ))
  MEMFREE=$(memory_pressure 2>/dev/null | awk -F': ' '/free percentage/{gsub(/%/,"",$2); print $2+0}')
  SWAP=$(sysctl -n vm.swapusage 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="used"){v=$(i+2); m=1; if(v~/G/)m=1024; gsub(/[MG]/,"",v); printf "%d", v*m; exit}}')
  SWAP=${SWAP:-0}
  if [ "${MEMFREE:-100}" -lt 15 ] || [ "$SWAP" -gt 6144 ]; then warn 'Memory: %s GB, %s%% free, swap %s — memory is tight; quit heavy apps or restart' "$RAM" "${MEMFREE:-?}" "$(hum $((SWAP * 1024)))"
  else ok 'Memory: %s GB, %s%% free, swap %s' "$RAM" "${MEMFREE:-?}" "$(hum $((SWAP * 1024)))"; fi
fi

if task check.cpu; then
  CORES=$(sysctl -n hw.ncpu 2>/dev/null || echo 1)
  LOAD=$(sysctl -n vm.loadavg 2>/dev/null | awk '{print $2}')
  HIGH=$(awk -v l="${LOAD:-0}" -v c="$CORES" 'BEGIN{print (l > c*1.5) ? 1 : 0}')
  if [ "$HIGH" = 1 ]; then warn 'CPU: load %s on %s cores — something is busy' "$LOAD" "$CORES"; else ok 'CPU: load %s on %s cores' "${LOAD:-?}" "$CORES"; fi
  TOPCPU=$(ps -Aceo pcpu=,comm= -r 2>/dev/null | head -3 | awk '{p=$1; $1=""; sub(/^ /,""); printf "%s%% %s\n", p, $0}' | paste -sd ',' - | sed 's/,/, /g')
  TOPMEM=$(ps -Aceo rss=,comm= -m 2>/dev/null | head -3 | awk '{r=$1; $1=""; sub(/^ /,""); printf "%.1f GB %s\n", r/1048576, $0}' | paste -sd ',' - | sed 's/,/, /g')
  [ -n "$TOPCPU" ] && info 'Top CPU:    %s' "$TOPCPU"
  [ -n "$TOPMEM" ] && info 'Top memory: %s' "$TOPMEM"
  if pmset -g therm 2>/dev/null | grep -qiE 'thermal warning level set|Speed_Limit[^0-9]*[0-9]{1,2}$'; then
    warn 'Thermal: the Mac is throttling right now'
  fi
fi

BCYC=""; BMAX=""
if task check.battery && pmset -g batt 2>/dev/null | grep -q InternalBattery; then
  BPCT=$(pmset -g batt | grep -o '[0-9]*%' | head -1)
  BP=$(system_profiler SPPowerDataType 2>/dev/null)
  BCYC=$(echo "$BP" | awk -F': ' '/Cycle Count/{print $2; exit}')
  BCOND=$(echo "$BP" | awk -F': ' '/Condition/{print $2; exit}')
  BMAX=$(echo "$BP" | awk -F': ' '/Maximum Capacity/{gsub(/%/,"",$2); print $2; exit}')
  if [ -n "$BCOND" ] && [ "$BCOND" != "Normal" ]; then warn 'Battery: %s charged, %s cycles, %s%% capacity, %s' "$BPCT" "${BCYC:-?}" "${BMAX:-?}" "$BCOND"
  elif [ -n "$BMAX" ] && [ "$BMAX" -lt 80 ]; then warn 'Battery: %s charged, %s cycles, %s%% capacity, %s — capacity under 80%%' "$BPCT" "${BCYC:-?}" "$BMAX" "${BCOND:-?}"
  else ok 'Battery: %s charged, %s cycles, %s%% capacity, %s' "$BPCT" "${BCYC:-?}" "${BMAX:-?}" "${BCOND:-?}"; fi
fi

# ================================================================ SECURITY
if task check.security; then
  section "Security"
  FV=$(fdesetup status 2>/dev/null)
  case "$FV" in *"is On"*) ok 'FileVault: on' ;; "") ;; *) warn 'FileVault: off — your disk is not encrypted (System Settings → Privacy & Security)' ;; esac
  FW=$(/usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate 2>/dev/null)
  case "$FW" in *enabled*) ok 'Firewall: on' ;; "") ;; *) warn 'Firewall: off (System Settings → Network → Firewall)' ;; esac
  SIP=$(csrutil status 2>/dev/null)
  case "$SIP" in *"status: enabled"*) ok 'System Integrity Protection: on' ;; "") ;; *) warn 'System Integrity Protection: off' ;; esac
  GK=$(spctl --status 2>/dev/null)
  case "$GK" in *enabled*) ok 'Gatekeeper: on' ;; "") ;; *) warn 'Gatekeeper: off — apps from anywhere can run' ;; esac
  AU=$(defaults read /Library/Preferences/com.apple.SoftwareUpdate AutomaticCheckEnabled 2>/dev/null)
  CR=$(defaults read /Library/Preferences/com.apple.SoftwareUpdate CriticalUpdateInstall 2>/dev/null)
  if [ "$AU" = 0 ]; then warn 'Automatic update checks: off'; elif [ "$CR" = 0 ]; then warn 'Security responses & system files: not installed automatically'; else ok 'Automatic security updates: on'; fi
  TMD=$(tmutil destinationinfo 2>/dev/null)
  if echo "$TMD" | grep -q 'Name'; then
    LB=$(tmutil latestbackup 2>/dev/null | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' | tail -1)
    if [ -n "$LB" ]; then
      AGE=$(( ( $(date +%s) - $(date -j -f %Y-%m-%d "$LB" +%s 2>/dev/null || date +%s) ) / 86400 ))
      if [ "$AGE" -gt 7 ]; then warn 'Time Machine: last backup %s (%s days ago)' "$LB" "$AGE"; else ok 'Time Machine: last backup %s' "$LB"; fi
    else info 'Time Machine: configured (last backup date needs Full Disk Access for Terminal)'; fi
  else
    warn 'Time Machine: no backup destination configured'
  fi
fi

# ================================================================ UPDATES
if WANT_UPD; then
if UPD; then section "Updates"; else section "Update status (check only, nothing installed)"; fi

if task update.claude && have claude; then
  v1=$(claude --version 2>/dev/null | awk '{print $1}')
  if UPD; then step 'Claude Code'; run claude update; fi
  v2=$(claude --version 2>/dev/null | awk '{print $1}')
  upd "Claude Code" "$v1" "$v2"
  if ! UPD && have npm; then
    latest=$(npm view @anthropic-ai/claude-code version 2>/dev/null)
    ver_gt "$latest" "$v2" && info "%s: %s is on npm (fine if you're on the stable channel)" "Claude Code" "$latest"
  fi
  PJSON="$HOME/.claude/plugins/installed_plugins.json"
  plugins(){ [ -f "$PJSON" ] && have python3 && python3 - "$PJSON" <<'PY' 2>/dev/null
import json, sys
d = json.load(open(sys.argv[1])); pl = d.get("plugins", d)
for k, v in sorted(pl.items()):
    es = v if isinstance(v, list) else [v]
    e = next((x for x in es if isinstance(x, dict) and x.get("scope", "user") == "user"), None)
    if e is None: continue   # project/local plugins belong to their project
    print(k, e.get("version") or (e.get("gitCommitSha") or "")[:7] or "?")
PY
  }
  P1=$(plugins)
  if UPD; then
    step 'Plugin marketplaces'
    if run claude plugin marketplace update; then ok 'Plugin marketplaces refreshed'; else warn 'Plugin marketplaces: refresh failed (see log)'; fi
    # no -y: a plugin whose marketplace asks to run a command is left for you to confirm (see log)
    printf '%s\n' "$P1" | while read -r name ver; do [ -n "$name" ] && { step 'Plugin %s' "$name"; (cd "$HOME" && run claude plugin update --scope user "$name"); }; done
  fi
  P2=$(plugins)
  if [ -n "$P2" ]; then
    while read -r name ver; do
      [ -z "$name" ] && continue
      old=$(printf '%s\n' "$P1" | awk -v n="$name" '$1==n{print $2}')
      if [ -n "$old" ] && [ "$old" != "$ver" ]; then ok 'Plugin %s: %s → %s' "$name" "$old" "$ver"; done_upd 'plugin %s %s → %s' "$name" "$old" "$ver"; else mdonly "$name $ver"; fi
    done <<EOF
$P2
EOF
    ok 'Claude Code plugins: %s installed' "$(cnt "$P2")"
  fi
fi

# npm and npx are node scripts: with node unlinked (keg-only node@24) they stay on PATH but cannot run
node_ok(){
  have node && return 0
  local fix; fix=$(link_fix node)
  if [ -n "$fix" ]; then warn '%s: skipped, node is not on PATH — run: %s' "$1" "$fix"; else warn '%s: skipped, node is not on PATH' "$1"; fi
  return 1
}

if task update.npm && have npm && have python3 && node_ok "$(_ 'npm globals')"; then
  step 'npm globals'
  # skips npm-link'ed packages and anything whose versions don't look like registry versions
  NO=$(npm outdated -g --json 2>/dev/null | python3 -c '
import json, os, sys, re
try: d = json.load(sys.stdin)
except Exception: d = {}
root = sys.argv[1]
ver = re.compile(r"^[0-9]+\.[0-9]+\.[0-9]+")
for k, v in d.items():
    c, l = str(v.get("current", "")), str(v.get("latest", ""))
    if os.path.islink(os.path.join(root, k)) or not ver.match(c) or not ver.match(l) or c == l: continue
    print(k, c, l)' "$(npm root -g 2>/dev/null)" 2>/dev/null)
  if [ -z "$NO" ]; then ok 'npm globals: up to date'
  else
    UPD || warn 'npm globals: %s outdated' "$(cnt "$NO")"
    while read -r p c l; do
      [ -z "$p" ] && continue
      if UPD; then
        step 'npm %s' "$p"
        if run npm install -g "$p@$l"; then ok '%s: %s → %s' "$p" "$c" "$l"; UPDATED+=("$p $c → $l"); else fail '%s: update failed (see log)' "$p"; fi
      else sub "$p: $c → $l"; fi
    done <<EOF
$NO
EOF
  fi
fi

LOCK="$HOME/.agents/.skill-lock.json"; LATER_SKILLS=""
if task update.skills && [ -f "$LOCK" ] && have npx && have python3 && node_ok "$(_ 'Agent skills')"; then
  skills(){ python3 -c '
import json, sys
d = json.load(open(sys.argv[1]))
for k, v in sorted(d.get("skills", {}).items()): print(k, v.get("skillFolderHash", "")[:7])' "$LOCK" 2>/dev/null; }
  S1=$(skills)
  if UPD; then
    step 'Agent skills'
    # -g: the global skills in ~/.agents, wherever macup is started from
    if (cd "$HOME" && run env CI=1 npx -y skills update -g); then
      S2=$(skills); n=0
      while read -r name h; do
        [ -z "$name" ] && continue
        old=$(printf '%s\n' "$S1" | awk -v n="$name" '$1==n{print $2}')
        [ "$old" != "$h" ] && { n=$((n+1)); done_upd 'skill %s' "$name"; }
      done <<EOF
$S2
EOF
      ok 'Agent skills: %s installed, %s updated' "$(cnt "$S2")" "$n"
    else fail 'Agent skills: update failed (see log)'; fi
  else
    # the skills CLI has no read-only check (`skills check` now updates), so a check only counts them
    LATER_SKILLS="$(_ 'Agent skills')"
  fi
fi

if task update.brew && have brew; then
  step 'brew update'; run brew update   # refreshes the package list only
  OF=$(brew outdated --formula --verbose 2>/dev/null); NF=$(cnt "$OF")
  OC=$(brew outdated --cask --verbose 2>/dev/null);    NC=$(cnt "$OC")
  if [ $((NF + NC)) -eq 0 ]; then ok 'Homebrew: up to date'
  else
    if UPD; then
      step 'brew upgrade (formulae: %s, casks: %s)' "$NF" "$NC"
      if run brew upgrade; then ok 'Homebrew: upgraded — formulae: %s, casks: %s' "$NF" "$NC"; else warn 'Homebrew: upgraded with errors (see log)'; fi
      done_upd 'Homebrew: formulae: %s, casks: %s' "$NF" "$NC"
    else warn 'Homebrew: outdated — formulae: %s, casks: %s' "$NF" "$NC"; fi
    lines "$(printf '%s\n%s\n' "$OF" "$OC")"
  fi
  # in a check the casks brew upgrades anyway are already listed above
  # not --greedy: a version :latest cask is always "outdated" and does not update itself
  GR=$(brew outdated --cask --greedy-auto-updates --quiet 2>/dev/null)
  UPD || GR=$(printf '%s\n' "$GR" | grep -vxF -f <(printf '%s\n' "$OC" | awk 'NF{print $1}'))
  if [ -n "$GR" ]; then
    GL=$(printf '%s\n' "$GR" | head -10 | paste -sd, - | sed 's/,/, /g'); GN=$(cnt "$GR")
    [ "$GN" -gt 10 ] && GL="$GL +$((GN - 10))"
    info 'Casks that update themselves: %s. Force with: brew upgrade --cask --greedy-auto-updates' "$GL"
  fi
fi

if task update.mas; then
  if have mas; then
    step 'App Store'
    # "497799835 Xcode (27.1 → 27.2)": the id for mas, the rest for people
    OM=$(mas outdated 2>/dev/null | sed -E 's/^ +//; s/ +/ /g; s/ -> / → /'); NM=$(cnt "$OM")
    if [ "$NM" -eq 0 ]; then ok 'App Store: up to date'
    elif UPD; then
      info 'App Store: updates: %s' "$NM"; lines "$(printf '%s\n' "$OM" | cut -d' ' -f2-)"
      i=0
      while read -r id app; do
        [ -z "$id" ] && continue; i=$((i + 1))
        # mas runs itself through sudo, which would ask a bare "Password:" in the middle of the step line
        if ! sudo -n true 2>/dev/null && ! { { : </dev/tty; } 2>/dev/null && printf '%s' "$CL" && sudo -v -p "  $(_ 'Mac password to install App Store updates:') "; }; then
          warn 'App Store: updates not installed: %s — they need your Mac password' "$((NM - i + 1))"; break
        fi
        if tick "App Store $i/$NM: $app" mas upgrade "$id"; then ok '%s: %s' 'App Store' "$app"; done_upd '%s: %s' 'App Store' "$app"
        else warn 'App Store: updates not installed: %s — open the App Store' "$app"; fi
      done <<EOF
$OM
EOF
    else warn 'App Store: updates: %s' "$NM"; lines "$(printf '%s\n' "$OM" | cut -d' ' -f2-)"; fi
  else info "App Store apps aren't checked: brew install mas"; fi
fi

LATER="${LATER_SKILLS:-}"
simple_update(){ # task-id label cmd...
  local id=$1 label; label=$(_ "$2"); shift 2
  task "$id" || return 0
  if UPD; then step '%s' "$label"; if run "$@"; then ok '%s: updated' "$label"; else warn '%s: update failed (see log)' "$label"; fi
  else LATER="$LATER${LATER:+, }$label"; fi
}
have pipx   && simple_update update.pipx   'pipx tools'      pipx upgrade-all
have uv     && simple_update update.uv     'uv tools'        uv tool upgrade --all
have rustup && simple_update update.rustup 'Rust toolchains' rustup update
[ -f "${ZSH:-$HOME/.oh-my-zsh}/tools/upgrade.sh" ] && have zsh && simple_update update.omz 'Oh My Zsh' env ZSH="${ZSH:-$HOME/.oh-my-zsh}" zsh "${ZSH:-$HOME/.oh-my-zsh}/tools/upgrade.sh"
have gh && [ -n "$(gh extension list 2>/dev/null)" ] && simple_update update.gh_ext 'gh extensions' gh extension upgrade --all
[ -n "$LATER" ] && info 'Not checked in this mode, updated by macup update: %s' "$LATER"

if task check.macos_updates; then
  step 'Looking for macOS updates (up to a minute)'
  SL=$(softwareupdate -l 2>&1)
  SU=$(printf '%s\n' "$SL" | sed -n 's/^[[:space:]]*\* Label: //p')
  # a Label is an id ("Command Line Tools for Xcode 27.2-27.2"); some Titles carry no version ("Safari")
  ST=$(printf '%s\n' "$SL" | sed -n 's/^[[:space:]]*Title: //p' | awk -F', Version: ' '{v=$2; sub(/,.*/, "", v); print (v == "" || index($1, v)) ? $1 : $1 " " v}')
  if [ -z "$SU" ]; then ok 'macOS: up to date'; else warn 'macOS: updates available — System Settings → General → Software Update'; lines "${ST:-$SU}"; fi
fi
fi # WANT_UPD

# ================================================================ TOOLS & SERVICES
section "Tools & services"
if task check.mcp && have claude; then
  step 'Checking MCP servers'
  # from $HOME: the list depends on the current folder (local-scope servers)
  MCP=$(cd "$HOME" && claude mcp list 2>/dev/null </dev/null | nocolor)
  MT=$(printf '%s\n' "$MCP" | grep -cE '✓|✔|✗|✘|⚠|Connected|Failed|[Aa]uth')
  BAD=$(printf '%s\n' "$MCP" | grep -E '✗|✘|⚠|Failed|[Nn]eeds auth')
  if [ "$MT" -eq 0 ]; then info 'Claude Code MCP servers: none configured'
  elif [ -z "$BAD" ]; then ok 'Claude Code MCP servers: all %s connected' "$MT"
  else warn 'Claude Code MCP servers: %s of %s not working' "$(cnt "$BAD")" "$MT"; lines "$BAD"; fi
fi
if task check.brew_doctor && have brew; then
  step 'brew doctor'
  DOC=$(brew doctor 2>&1); echo "$DOC" >>"$RAW"
  ND=$(printf '%s\n' "$DOC" | grep -c '^Warning:')
  if [ "$ND" -gt 0 ]; then warn 'brew doctor: %s warnings (details in the log)' "$ND"; else ok 'brew doctor: all good'; fi
fi
if task check.xcode; then
  if XP=$(xcode-select -p 2>/dev/null) && [ -d "$XP" ]; then
    XV=$(xcodebuild -version 2>/dev/null | head -1)
    ok 'Developer tools: %s (%s)' "${XV:-$(_ 'Command Line Tools only')}" "$(tildify "$XP")"
  else warn 'Developer tools: not installed or broken — run: xcode-select --install'; fi
  if have xcrun && have python3; then
    RT=$(xcrun simctl runtime list -j 2>/dev/null | python3 -c '
import json, sys
try: d = json.load(sys.stdin)
except Exception: sys.exit()
rs = sorted(d.values(), key=lambda r: (r.get("platformIdentifier",""), r.get("version","")))
print(len(rs), sum(r.get("sizeBytes", 0) for r in rs) // 1024)
for r in rs: print("%s %s · %.1f GB" % (r.get("platformIdentifier","").split(".")[-1].replace("platform",""), r.get("version","?"), r.get("sizeBytes",0)/1e9))' 2>/dev/null)
    if [ -n "$RT" ]; then
      read -r RN RK <<EOF
$(printf '%s\n' "$RT" | head -1)
EOF
      if [ "${RN:-0}" -gt 0 ]; then
        info 'Simulator runtimes: %s, %s — remove old ones in Xcode → Settings → Components' "$RN" "$(hum "$RK")"
        printf '%s\n' "$RT" | tail -n +2 | while IFS= read -r l; do mdonly "$l"; done
      fi
    fi
  fi
fi
if task check.devtools; then
  tool(){ [ -n "$2" ] && TOOLS="$TOOLS${TOOLS:+ · }$1 $2"; }
  TOOLS=""
