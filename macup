if task update.brew && have brew; then
  if UPD; then step 'brew update'; run brew update
  else export HOMEBREW_NO_AUTO_UPDATE=1   # brew update also updates Homebrew itself and its taps; a check changes nothing
  fi
  OF=$(brew outdated --formula --verbose 2>/dev/null); NF=$(cnt "$OF")
  OC=$(brew outdated --cask --verbose 2>/dev/null);    NC=$(cnt "$OC")
  if [ $((NF + NC)) -eq 0 ]; then ok 'Homebrew: up to date'
  else
    if UPD; then
      step 'brew upgrade (formulae: %s, casks: %s)' "$NF" "$NC"
      # a cask's installer may ask for the Mac password: the updaters that run next must not find sudo unlocked by it
      SUDO_PRE=0; sudo -n true 2>/dev/null && SUDO_PRE=1
      run brew upgrade; BRC=$?
      [ "$SUDO_PRE" = 0 ] && sudo -k 2>/dev/null
      if [ $BRC = 0 ]; then ok 'Homebrew: upgraded — formulae: %s, casks: %s' "$NF" "$NC"; else err 'Homebrew: upgraded with errors (see the report)'; fi
      done_upd 'Homebrew: formulae: %s, casks: %s' "$NF" "$NC"
    else warn 'Homebrew: outdated — formulae: %s, casks: %s' "$NF" "$NC"; fi
    lines "$(printf '%s\n%s\n' "$OF" "$OC")"
  fi
  if ! UPD; then
    BT=0; BR=$(brew --repository 2>/dev/null); BA=$(brew --cache 2>/dev/null)
    for f in "$BR/.git/FETCH_HEAD" "$BA/api/formula.jws.json" "$BA/api/cask.jws.json"; do
      t=$(stat -f %m "$f" 2>/dev/null); [ -n "$t" ] && [ "$t" -gt "$BT" ] && BT=$t
    done
    [ "$BT" -gt 0 ] && [ $(($(date +%s) - BT)) -gt 86400 ] && info 'The Homebrew package list is from %s; macup update refreshes it' "$(date -r "$BT" +%Y-%m-%d)"
  fi
  # in a check the casks brew upgrades anyway are already listed above
  # not --greedy: a version :latest cask is always "outdated" and does not update itself
  GR=$(brew outdated --cask --greedy-auto-updates --quiet 2>/dev/null)
  UPD || GR=$(printf '%s\n' "$GR" | grep -vxF -f <(printf '%s\n' "$OC" | awk 'NF{print $1}'))
  if [ -n "$GR" ]; then
    GL=$(printf '%s\n' "$GR" | head -10 | paste -sd, - | sed 's/,/, /g'); GN=$(cnt "$GR")
    [ "$GN" -gt 10 ] && GL="$GL +$((GN - 10))"
    info 'Casks that update themselves: %s. Force with: brew upgrade --cask --greedy-auto-updates' "$GL"
  fi
fi

if task update.mas; then
  if have mas; then
    step 'App Store'
    # "497799835 Xcode (27.1 → 27.2)": the id for mas, the rest for people
    OM=$(tl 180 mas outdated 2>/dev/null | sed -E 's/^ +//; s/ +/ /g; s/ -> / → /'); NM=$(cnt "$OM")
    if [ "$NM" -eq 0 ]; then ok 'App Store: up to date'
    elif UPD; then
      info 'App Store: updates: %s' "$NM"; lines "$(printf '%s\n' "$OM" | cut -d' ' -f2-)"
      i=0
      while read -r id app; do
        [ -z "$id" ] && continue; i=$((i + 1))
        # mas runs itself through sudo, which would ask a bare "Password:" in the middle of the step line
        if ! sudo -n true 2>/dev/null; then
          if { : </dev/tty; } 2>/dev/null && printf '%s' "$CL" && sudo -v -p "  $(_ 'Mac password to install App Store updates:') "; then SUDO_ASKED=1
          else err 'App Store: updates not installed: %s — they need your Mac password' "$((NM - i + 1))"; break; fi
        fi
        # sudo forgets the password after 5 minutes and one install (Xcode) takes longer, so it would ask again for the next app
        [ -z "${SUDO_KEEP:-}" ] && { while kill -0 $$ 2>/dev/null; do sleep 50; sudo -n -v || break; done </dev/null >/dev/null 2>&1 & SUDO_KEEP=$!; }
        # an Xcode download alone can take longer than any other step
        if RUN_SECS=$((STEP_SECS * 4)) tick "App Store $i/$NM: $app" mas upgrade "$id"; then ok '%s: %s' 'App Store' "$app"; done_upd '%s: %s' 'App Store' "$app"
        else err 'App Store: updates not installed: %s — open the App Store' "$app"; fi
      done <<EOF
$OM
EOF
      stop_sudo_keep
    else warn 'App Store: updates: %s' "$NM"; lines "$(printf '%s\n' "$OM" | cut -d' ' -f2-)"; fi
  else info "App Store apps aren't checked: brew install mas"; fi
