# ---------------------------------------------------------------- arguments
DRY=0; DO_UPDATE=1; DO_CLEAN=1; DEEP=0; ACTION=""; CMD=""; LANG_ARG=""
cleanup_lang(){ [ -n "$LANGFILE" ] && rm -f "$LANGFILE"; }
trap cleanup_lang EXIT
set_lang(){ case "$1" in en|uk|ru) MSG_LANG=$1 ;; ua) MSG_LANG=uk ;; *) echo "--lang: en | uk | ru"; exit 2 ;; esac; load_lang; }
while [ $# -gt 0 ]; do case "$1" in
  check|-n|--dry-run)   DRY=1; ACTION=check ;;
  all|run)              ACTION=all ;;
  update|--no-clean)    DO_CLEAN=0; ACTION=update ;;
  clean|--no-update)    DO_UPDATE=0; ACTION=clean ;;
  deep|--deep)          DEEP=1 ;;
  --skip)               CLI_SKIP="$CLI_SKIP,$2"; shift ;;
  --skip=*)             CLI_SKIP="$CLI_SKIP,${1#*=}" ;;
  --only)               CLI_ONLY="$CLI_ONLY,$2"; shift ;;
  --only=*)             CLI_ONLY="$CLI_ONLY,${1#*=}" ;;
  --lang)               set_lang "$2"; shift ;;
  --lang=*)             set_lang "${1#*=}" ;;
  --no-color)           B=; G=; Y=; R=; C=; D=; N=; CL= ;;
  lang|language)        CMD=lang; case "${2:-}" in ""|-*) ;; *) LANG_ARG=$2; shift ;; esac ;;
  last|--last)          CMD=last ;;
  history|--history)    CMD=history ;;
  reports|--reports)    CMD=reports ;;
  tasks|--tasks)        CMD=tasks ;;
  config|--config)      CMD=config ;;
  self-update|selfupdate|upgrade) CMD=self_update ;;
  uninstall)            CMD=uninstall ;;
  help|-h|--help)       CMD=help ;;
  version|-v|--version) CMD=version ;;
  *) _f 'Unknown command: %s' "$1"; echo; _ 'Type  macup  for the menu or  macup help  for all commands.'; echo; exit 1 ;;
esac; shift; done

# one-off commands run after all options are read, so `macup help --lang uk` works
case "$CMD" in
  lang)        choose_lang "$LANG_ARG"; exit $? ;;
  last)        show_last; exit 0 ;;
  history)     show_history; exit 0 ;;
  reports)     mkdir -p "$LOGDIR"; open "$LOGDIR"; exit 0 ;;
  tasks)       list_tasks; exit 0 ;;
  config)      open_conf; exit 0 ;;
  self_update) self_update; exit 0 ;;
  uninstall)   uninstall; exit 0 ;;
  help)        usage; exit 0 ;;
  version)     echo "macup $MACUP_VERSION"; exit 0 ;;
esac

# Changing anything needs an explicit command (all, update, clean). Without one:
# a terminal gets the menu, `macup --deep` is a deep check, anything else gets the help.
if [ -z "$ACTION" ]; then
  if [ "$DEEP" = 1 ]; then DRY=1
  elif [ -t 0 ] && [ -t 1 ]; then menu
  else usage; exit 2; fi
fi

load_conf
mkdir -p "$LOGDIR" "$STATE_DIR"
STAMP=$(date +%Y-%m-%d_%H-%M)
REPORT="$LOGDIR/macup_$STAMP.md"
RAW="$LOGDIR/macup_$STAMP.log"
BODY=$(mktemp "${TMPDIR:-/tmp}/macup.XXXXXX")
trap 'printf "\n%s%s%s\n" "$Y" "$(_f "Interrupted. Log: %s" "$(tildify "$RAW")")" "$N"; rm -f "$BODY"; cleanup_lang; exit 130' INT
trap 'rm -f "$BODY"; cleanup_lang' EXIT

if [ "$DRY" = 1 ]; then MODE="check"; elif [ "$DO_UPDATE" = 0 ]; then MODE="clean"; elif [ "$DO_CLEAN" = 0 ]; then MODE="update"; else MODE="all"; fi
[ "$DEEP" = 1 ] && MODE="$MODE+deep"
printf '%smacup %s%s · %s%s\n' "$B" "$MACUP_VERSION" "$N" "$MODE" "$( [ "$DRY" = 1 ] && printf ' · %s' "$(_ 'nothing will be installed or deleted')")"

PREV=$( [ -s "$HISTORY" ] && tail -n 1 "$HISTORY")

# ================================================================ SYSTEM
section "System"
OSV=$(sw_vers -productVersion 2>/dev/null)
if task check.system; then
  UPTXT=$(uptime | sed -E 's/.* up ([^,]+(, *[0-9]+:[0-9]+)?),.*/\1/')
  BOOT=$(sysctl -n kern.boottime 2>/dev/null | awk -F'sec = ' '{print $2+0}')
  UPDAYS=$(( ( $(date +%s) - ${BOOT:-$(date +%s)} ) / 86400 ))
  BUILD=$(sw_vers -buildVersion 2>/dev/null); MODEL=$(sysctl -n hw.model 2>/dev/null)
  if [ "$UPDAYS" -ge 14 ]; then warn 'macOS %s (%s) · %s · up %s — restart recommended (%s days without restart)' "$OSV" "$BUILD" "$MODEL" "$UPTXT" "$UPDAYS"
  else ok 'macOS %s (%s) · %s · up %s' "$OSV" "$BUILD" "$MODEL" "$UPTXT"; fi
fi

D_TOTAL=$(df -k /System/Volumes/Data 2>/dev/null | awk 'NR==2{print $2}'); D_TOTAL=${D_TOTAL:-1}
FREE_BEFORE=$(df -k /System/Volumes/Data 2>/dev/null | awk 'NR==2{print $4}'); FREE_BEFORE=${FREE_BEFORE:-0}
if task check.disk; then
  PCT=$(( FREE_BEFORE * 100 / D_TOTAL )); F1=$(hum "$FREE_BEFORE"); F2=$(hum "$D_TOTAL")
  if   [ "$PCT" -lt 10 ]; then fail 'Disk: %s free of %s (%s%%) — critically low' "$F1" "$F2" "$PCT"
  elif [ "$PCT" -lt 20 ]; then warn 'Disk: %s free of %s (%s%%) — getting low' "$F1" "$F2" "$PCT"
  else ok 'Disk: %s free of %s (%s%%)' "$F1" "$F2" "$PCT"; fi
  SMART=$(diskutil info disk0 2>/dev/null | awk -F': *' '/SMART Status/{print $2}')
  if [ -n "$SMART" ]; then
    case "$SMART" in Verified|"Not Supported") ok 'Disk health (SMART): %s' "$SMART" ;; *) fail 'Disk health (SMART): %s — back up now' "$SMART" ;; esac
  fi
  SNAPS=$(tmutil listlocalsnapshots / 2>/dev/null | grep -c 'com.apple')
  [ "${SNAPS:-0}" -gt 0 ] && info 'Local Time Machine snapshots: %s (macOS frees them automatically when space runs low)' "$SNAPS"
fi

MEMFREE=""; SWAP=0
if task check.memory; then
  RAM=$(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1073741824 ))
  MEMFREE=$(memory_pressure 2>/dev/null | awk -F': ' '/free percentage/{gsub(/%/,"",$2); print $2+0}')
  SWAP=$(sysctl -n vm.swapusage 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="used"){v=$(i+2); m=1; if(v~/G/)m=1024; gsub(/[MG]/,"",v); printf "%d", v*m; exit}}')
  SWAP=${SWAP:-0}
  if [ "${MEMFREE:-100}" -lt 15 ] || [ "$SWAP" -gt 6144 ]; then warn 'Memory: %s GB, %s%% free, swap %s MB — memory is tight; quit heavy apps or restart' "$RAM" "${MEMFREE:-?}" "$SWAP"
  else ok 'Memory: %s GB, %s%% free, swap %s MB' "$RAM" "${MEMFREE:-?}" "$SWAP"; fi
fi

if task check.cpu; then
  CORES=$(sysctl -n hw.ncpu 2>/dev/null || echo 1)
  LOAD=$(sysctl -n vm.loadavg 2>/dev/null | awk '{print $2}')
  HIGH=$(awk -v l="${LOAD:-0}" -v c="$CORES" 'BEGIN{print (l > c*1.5) ? 1 : 0}')
  if [ "$HIGH" = 1 ]; then warn 'CPU: load %s on %s cores — something is busy' "$LOAD" "$CORES"; else ok 'CPU: load %s on %s cores' "${LOAD:-?}" "$CORES"; fi
  TOPCPU=$(ps -Aceo pcpu=,comm= -r 2>/dev/null | head -3 | awk '{p=$1; $1=""; sub(/^ /,""); printf "%s%% %s\n", p, $0}' | paste -sd ',' - | sed 's/,/, /g')
  TOPMEM=$(ps -Aceo rss=,comm= -m 2>/dev/null | head -3 | awk '{r=$1; $1=""; sub(/^ /,""); printf "%.1f GB %s\n", r/1048576, $0}' | paste -sd ',' - | sed 's/,/, /g')
  [ -n "$TOPCPU" ] && info 'Top CPU:    %s' "$TOPCPU"
  [ -n "$TOPMEM" ] && info 'Top memory: %s' "$TOPMEM"
  if pmset -g therm 2>/dev/null | grep -qiE 'thermal warning level set|Speed_Limit[^0-9]*[0-9]{1,2}$'; then
    warn 'Thermal: the Mac is throttling right now'
  fi
fi

BCYC=""; BMAX=""
if task check.battery && pmset -g batt 2>/dev/null | grep -q InternalBattery; then
  BPCT=$(pmset -g batt | grep -o '[0-9]*%' | head -1)
  BP=$(system_profiler SPPowerDataType 2>/dev/null)
  BCYC=$(echo "$BP" | awk -F': ' '/Cycle Count/{print $2; exit}')
  BCOND=$(echo "$BP" | awk -F': ' '/Condition/{print $2; exit}')
  BMAX=$(echo "$BP" | awk -F': ' '/Maximum Capacity/{gsub(/%/,"",$2); print $2; exit}')
  if [ -n "$BCOND" ] && [ "$BCOND" != "Normal" ]; then warn 'Battery: %s charged, %s cycles, %s%% capacity, %s' "$BPCT" "${BCYC:-?}" "${BMAX:-?}" "$BCOND"
  elif [ -n "$BMAX" ] && [ "$BMAX" -lt 80 ]; then warn 'Battery: %s charged, %s cycles, %s%% capacity, %s — capacity under 80%%' "$BPCT" "${BCYC:-?}" "$BMAX" "${BCOND:-?}"
  else ok 'Battery: %s charged, %s cycles, %s%% capacity, %s' "$BPCT" "${BCYC:-?}" "${BMAX:-?}" "${BCOND:-?}"; fi
fi

# ================================================================ SECURITY
if task check.security; then
  section "Security"
  FV=$(fdesetup status 2>/dev/null)
  case "$FV" in *"is On"*) ok 'FileVault: on' ;; "") ;; *) warn 'FileVault: off — your disk is not encrypted (System Settings → Privacy & Security)' ;; esac
  FW=$(/usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate 2>/dev/null)
  case "$FW" in *enabled*) ok 'Firewall: on' ;; "") ;; *) warn 'Firewall: off (System Settings → Network → Firewall)' ;; esac
  SIP=$(csrutil status 2>/dev/null)
  case "$SIP" in *"status: enabled"*) ok 'System Integrity Protection: on' ;; "") ;; *) warn 'System Integrity Protection: off' ;; esac
  GK=$(spctl --status 2>/dev/null)
  case "$GK" in *enabled*) ok 'Gatekeeper: on' ;; "") ;; *) warn 'Gatekeeper: off — apps from anywhere can run' ;; esac
  AU=$(defaults read /Library/Preferences/com.apple.SoftwareUpdate AutomaticCheckEnabled 2>/dev/null)
  CR=$(defaults read /Library/Preferences/com.apple.SoftwareUpdate CriticalUpdateInstall 2>/dev/null)
  if [ "$AU" = 0 ]; then warn 'Automatic update checks: off'; elif [ "$CR" = 0 ]; then warn 'Security responses & system files: not installed automatically'; else ok 'Automatic security updates: on'; fi
  TMD=$(tmutil destinationinfo 2>/dev/null)
  if echo "$TMD" | grep -q 'Name'; then
    LB=$(tmutil latestbackup 2>/dev/null | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' | tail -1)
    if [ -n "$LB" ]; then
      AGE=$(( ( $(date +%s) - $(date -j -f %Y-%m-%d "$LB" +%s 2>/dev/null || date +%s) ) / 86400 ))
      if [ "$AGE" -gt 7 ]; then warn 'Time Machine: last backup %s (%s days ago)' "$LB" "$AGE"; else ok 'Time Machine: last backup %s' "$LB"; fi
    else info 'Time Machine: configured (last backup date needs Full Disk Access for Terminal)'; fi
  else
    warn 'Time Machine: no backup destination configured'
  fi
fi

# ================================================================ UPDATES
if WANT_UPD; then
if UPD; then section "Updates"; else section "Available updates (not installed)"; fi

if task update.claude && have claude; then
  v1=$(claude --version 2>/dev/null | awk '{print $1}')
  if UPD; then step 'Claude Code'; run claude update; fi
  v2=$(claude --version 2>/dev/null | awk '{print $1}')
  upd "Claude Code" "$v1" "$v2"
  if ! UPD && have npm; then
    latest=$(npm view @anthropic-ai/claude-code version 2>/dev/null)
    ver_gt "$latest" "$v2" && info "%s: %s is on npm (fine if you're on the stable channel)" "Claude Code" "$latest"
  fi
  PJSON="$HOME/.claude/plugins/installed_plugins.json"
  plugins(){ [ -f "$PJSON" ] && have python3 && python3 - "$PJSON" <<'PY' 2>/dev/null
import json, sys
d = json.load(open(sys.argv[1])); pl = d.get("plugins", d)
for k, v in sorted(pl.items()):
    es = v if isinstance(v, list) else [v]
    e = next((x for x in es if isinstance(x, dict) and x.get("scope", "user") == "user"), None)
    if e is None: continue   # project/local plugins belong to their project
    print(k, e.get("version") or (e.get("gitCommitSha") or "")[:7] or "?")
PY
  }
  P1=$(plugins)
  if UPD; then
    step 'Plugin marketplaces'
    if run claude plugin marketplace update; then ok 'Plugin marketplaces refreshed'; else warn 'Plugin marketplaces: refresh failed (see log)'; fi
    # no -y: a plugin whose marketplace asks to run a command is left for you to confirm (see log)
    printf '%s\n' "$P1" | while read -r name ver; do [ -n "$name" ] && { step 'Plugin %s' "$name"; (cd "$HOME" && run claude plugin update --scope user "$name"); }; done
  fi
  P2=$(plugins)
  if [ -n "$P2" ]; then
    while read -r name ver; do
      [ -z "$name" ] && continue
      old=$(printf '%s\n' "$P1" | awk -v n="$name" '$1==n{print $2}')
      if [ -n "$old" ] && [ "$old" != "$ver" ]; then ok 'Plugin %s: %s → %s' "$name" "$old" "$ver"; done_upd 'plugin %s %s → %s' "$name" "$old" "$ver"; else mdonly "$name $ver"; fi
    done <<EOF
$P2
EOF
    ok 'Claude Code plugins: %s installed' "$(cnt "$P2")"
  fi
fi

if task update.npm && have npm && have python3; then
  step 'npm globals'
  # skips npm-link'ed packages and anything whose versions don't look like registry versions
  NO=$(npm outdated -g --json 2>/dev/null | python3 -c '
import json, os, sys, re
try: d = json.load(sys.stdin)
except Exception: d = {}
root = sys.argv[1]
ver = re.compile(r"^[0-9]+\.[0-9]+\.[0-9]+")
for k, v in d.items():
    c, l = str(v.get("current", "")), str(v.get("latest", ""))
    if os.path.islink(os.path.join(root, k)) or not ver.match(c) or not ver.match(l) or c == l: continue
    print(k, c, l)' "$(npm root -g 2>/dev/null)" 2>/dev/null)
  if [ -z "$NO" ]; then ok 'npm globals: up to date'
  else
    UPD || warn 'npm globals: %s outdated' "$(cnt "$NO")"
    while read -r p c l; do
      [ -z "$p" ] && continue
      if UPD; then
        step 'npm %s' "$p"
        if run npm install -g "$p@$l"; then ok '%s: %s → %s' "$p" "$c" "$l"; UPDATED+=("$p $c → $l"); else fail '%s: update failed (see log)' "$p"; fi
      else sub "$p: $c → $l"; fi
    done <<EOF
$NO
EOF
  fi
fi

LOCK="$HOME/.agents/.skill-lock.json"; LATER_SKILLS=""
if task update.skills && [ -f "$LOCK" ] && have npx && have python3; then
  skills(){ python3 -c '
import json, sys
d = json.load(open(sys.argv[1]))
for k, v in sorted(d.get("skills", {}).items()): print(k, v.get("skillFolderHash", "")[:7])' "$LOCK" 2>/dev/null; }
  S1=$(skills)
  if UPD; then
    step 'Agent skills'
    # -g: the global skills in ~/.agents, wherever macup is started from
    if (cd "$HOME" && run env CI=1 npx -y skills update -g); then
      S2=$(skills); n=0
      while read -r name h; do
        [ -z "$name" ] && continue
        old=$(printf '%s\n' "$S1" | awk -v n="$name" '$1==n{print $2}')
        [ "$old" != "$h" ] && { n=$((n+1)); done_upd 'skill %s' "$name"; }
      done <<EOF
$S2
EOF
      ok 'Agent skills: %s installed, %s updated' "$(cnt "$S2")" "$n"
    else fail 'Agent skills: update failed (see log)'; fi
  else
    # the skills CLI has no read-only check (`skills check` now updates), so a check only counts them
    LATER_SKILLS="$(_ 'Agent skills') ($(cnt "$S1"))"
  fi
fi

if task update.brew && have brew; then
  step 'brew update'; run brew update   # refreshes the package list only
  OF=$(brew outdated --formula --verbose 2>/dev/null); NF=$(cnt "$OF")
  OC=$(brew outdated --cask --verbose 2>/dev/null);    NC=$(cnt "$OC")
  if [ $((NF + NC)) -eq 0 ]; then ok 'Homebrew: up to date'
  else
    if UPD; then
      step 'brew upgrade (%s formulae, %s casks)' "$NF" "$NC"
      if run brew upgrade; then ok 'Homebrew: upgraded %s formulae, %s casks' "$NF" "$NC"; else warn 'Homebrew: upgraded with errors (see log)'; fi
      done_upd 'Homebrew: %s formulae, %s casks' "$NF" "$NC"
    else warn 'Homebrew: %s formulae, %s casks outdated' "$NF" "$NC"; fi
    lines "$(printf '%s\n%s\n' "$OF" "$OC")"
  fi
  GR=$(cnt "$(brew outdated --cask --greedy --quiet 2>/dev/null)"); UPD || GR=$((GR - NC))
  [ "$GR" -gt 0 ] && info '%s more casks update themselves (Chrome, Slack, …). Force with: brew upgrade --cask --greedy' "$GR"
fi

if task update.mas; then
  if have mas; then
    step 'App Store'
    OM=$(mas outdated 2>/dev/null); NM=$(cnt "$OM")
    if [ "$NM" -eq 0 ]; then ok 'App Store: up to date'
    elif UPD; then
      if run mas upgrade; then ok 'App Store: %s apps updated' "$NM"; done_upd 'App Store: %s apps' "$NM"; else warn "App Store: %s updates didn't install — open the App Store" "$NM"; fi
    else warn 'App Store: %s updates' "$NM"; lines "$OM"; fi
  else info "App Store apps aren't checked: brew install mas"; fi
fi

LATER="${LATER_SKILLS:-}"
simple_update(){ # task-id label cmd...
  local id=$1 label; label=$(_ "$2"); shift 2
  task "$id" || return 0
  if UPD; then step '%s' "$label"; if run "$@"; then ok '%s: updated' "$label"; else warn '%s: update failed (see log)' "$label"; fi
  else LATER="$LATER${LATER:+, }$label"; fi
}
have pipx   && simple_update update.pipx   'pipx tools'      pipx upgrade-all
have uv     && simple_update update.uv     'uv tools'        uv tool upgrade --all
have rustup && simple_update update.rustup 'Rust toolchains' rustup update
[ -f "${ZSH:-$HOME/.oh-my-zsh}/tools/upgrade.sh" ] && have zsh && simple_update update.omz 'Oh My Zsh' env ZSH="${ZSH:-$HOME/.oh-my-zsh}" zsh "${ZSH:-$HOME/.oh-my-zsh}/tools/upgrade.sh"
have gh && [ -n "$(gh extension list 2>/dev/null)" ] && simple_update update.gh_ext 'gh extensions' gh extension upgrade --all
[ -n "$LATER" ] && info 'Updated on a full run (no version check): %s' "$LATER"

if task check.macos_updates; then
  step 'Looking for macOS updates (up to a minute)'
  SU=$(softwareupdate -l 2>&1 | sed -n 's/^[[:space:]]*\* Label: //p')
  if [ -z "$SU" ]; then ok 'macOS: up to date'; else warn 'macOS: updates available — System Settings → General → Software Update'; lines "$SU"; fi
fi
fi # WANT_UPD

# ================================================================ TOOLS & SERVICES
section "Tools & services"
if task check.mcp && have claude; then
  step 'Checking MCP servers'
  # from $HOME: the list depends on the current folder (local-scope servers)
  MCP=$(cd "$HOME" && claude mcp list 2>/dev/null </dev/null | nocolor)
  MT=$(printf '%s\n' "$MCP" | grep -cE '✓|✔|✗|✘|⚠|Connected|Failed|[Aa]uth')
  BAD=$(printf '%s\n' "$MCP" | grep -E '✗|✘|⚠|Failed|[Nn]eeds auth')
  if [ "$MT" -eq 0 ]; then info 'Claude Code MCP servers: none configured'
  elif [ -z "$BAD" ]; then ok 'Claude Code MCP servers: all %s connected' "$MT"
  else warn 'Claude Code MCP servers: %s of %s not working' "$(cnt "$BAD")" "$MT"; lines "$BAD"; fi
fi
if task check.brew_doctor && have brew; then
  step 'brew doctor'
  DOC=$(brew doctor 2>&1); echo "$DOC" >>"$RAW"
  ND=$(printf '%s\n' "$DOC" | grep -c '^Warning:')
  if [ "$ND" -gt 0 ]; then warn 'brew doctor: %s warnings (details in the log)' "$ND"; else ok 'brew doctor: all good'; fi
fi
if task check.xcode; then
  if XP=$(xcode-select -p 2>/dev/null) && [ -d "$XP" ]; then
    XV=$(xcodebuild -version 2>/dev/null | head -1)
    ok 'Developer tools: %s (%s)' "${XV:-$(_ 'Command Line Tools only')}" "$(tildify "$XP")"
  else warn 'Developer tools: not installed or broken — run: xcode-select --install'; fi
  if have xcrun && have python3; then
    RT=$(xcrun simctl runtime list -j 2>/dev/null | python3 -c '
import json, sys
try: d = json.load(sys.stdin)
except Exception: sys.exit()
rs = sorted(d.values(), key=lambda r: (r.get("platformIdentifier",""), r.get("version","")))
print(len(rs), sum(r.get("sizeBytes", 0) for r in rs) // 1024)
for r in rs: print("%s %s · %.1f GB" % (r.get("platformIdentifier","").split(".")[-1].replace("platform",""), r.get("version","?"), r.get("sizeBytes",0)/1e9))' 2>/dev/null)
    if [ -n "$RT" ]; then
      read -r RN RK <<EOF
$(printf '%s\n' "$RT" | head -1)
EOF
      if [ "${RN:-0}" -gt 0 ]; then
        info 'Simulator runtimes: %s, %s — remove old ones in Xcode → Settings → Components' "$RN" "$(hum "$RK")"
        printf '%s\n' "$RT" | tail -n +2 | while IFS= read -r l; do mdonly "$l"; done
      fi
    fi
  fi
fi
if task check.devtools; then
  tool(){ [ -n "$2" ] && TOOLS="$TOOLS${TOOLS:+ · }$1 $2"; }
  TOOLS=""
  have swift   && tool Swift     "$(swift --version 2>&1 | grep -o 'Swift version [0-9.]*' | head -1 | sed 's/Swift version //')"
  have pod     && tool CocoaPods "$(pod --version 2>/dev/null)"
  have flutter && tool Flutter   "$(flutter --version 2>/dev/null | head -1 | sed 's/^Flutter //; s/ •.*//')"
  have node    && tool Node      "$(node --version 2>/dev/null | sed 's/^v//')"
  have ruby    && tool Ruby      "$(ruby -e 'print RUBY_VERSION' 2>/dev/null)"
  have python3 && tool Python    "$(python3 -c 'import platform; print(platform.python_version())' 2>/dev/null)"
  have codex   && tool Codex     "$(codex --version 2>/dev/null | head -1 | awk '{print $NF}')"
  [ -n "$TOOLS" ] && info '%s' "$TOOLS"
  [ -d /Applications/Claude.app ] && info 'Claude Desktop %s (updates itself)' "$(defaults read /Applications/Claude.app/Contents/Info.plist CFBundleShortVersionString 2>/dev/null)"
fi
if task check.docker && have docker && docker info >/dev/null 2>&1; then
  DDF=$(docker system df 2>/dev/null | awk 'NR>1{printf "%s %s (%s); ", $1, $4, $5}')
  info 'Docker: %s — clean manually with: docker system prune' "${DDF%; }"
fi

# ================================================================ CLEANUP
if WANT_CLN; then
if CLEAN; then section "Cleanup"; else section "What cleanup would free"; fi

safe_path(){ case "$1" in "$HOME"/Library/*|"$HOME"/.*) return 0 ;; esac; return 1; }
account(){ # label(translated) size_kb
  if CLEAN; then FREED=$((FREED + $2)); if [ "$2" -ge 1024 ]; then ok '%s: freed %s' "$1" "$(hum "$2")"; else ok '%s: cleaned' "$1"; fi
  else POTENTIAL=$((POTENTIAL + $2)); info '%s: %s' "$1" "$(hum "$2")"; fi
}
clean_dir(){ # id label path [xcode]
  local id=$1 label p=$3 s a; label=$(_ "$2")
  task "$id" || return 0
  [ -d "$p" ] && safe_path "$p" || return 0
  s=$(kb "$p"); [ "$s" -lt 5120 ] && return 0
  if CLEAN && [ "$4" = xcode ] && XCODE_ON; then info '%s: %s — skipped, Xcode is open' "$label" "$(hum "$s")"; return 0; fi
  if CLEAN; then step '%s' "$label"; find "$p" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>>"$RAW"; a=$(kb "$p"); s=$((s - a)); fi
  account "$label" "$s"
}
clean_old(){ # id label dir days [type] — deletes entries older than N days
  local id=$1 label p=$3 days=$4 type=${5:-d} old s=0 x; label=$(_ "$2")
  task "$id" || return 0
  [ -d "$p" ] && safe_path "$p" || return 0
  old=$(find "$p" -mindepth 1 -maxdepth 1 -type "$type" -mtime +"$days" 2>/dev/null)
  [ -z "$old" ] && return 0
  while IFS= read -r x; do s=$((s + $(kb "$x"))); done <<EOF
$old
EOF
  [ "$s" -lt 1024 ] && return 0
  CLEAN && while IFS= read -r x; do rm -rf "$x"; done <<EOF
$old
EOF
  account "$(_f '%s (%s items, older than %s days)' "$label" "$(cnt "$old")" "$days")" "$s"
}
measure_cmd(){ # id label dir cmd... — run a cleaning command, measure a dir before/after
  local id=$1 label p=$3 s a; label=$(_ "$2"); shift 3
  task "$id" || return 0
  [ -e "$p" ] || return 0
  s=$(kb "$p")
  if CLEAN; then step '%s' "$label"; run "$@"; a=$(kb "$p"); s=$((s - a)); [ "$s" -lt 0 ] && s=0; account "$label" "$s"
  elif [ "$s" -ge 5120 ]; then info '%s: %s in cache (part of it is freeable)' "$label" "$(hum "$s")"; fi
}

DEV="$HOME/Library/Developer"
clean_dir  clean.derived_data   'Xcode DerivedData'    "$DEV/Xcode/DerivedData" xcode
clean_dir  clean.xcode_previews 'SwiftUI previews'     "$DEV/Xcode/UserData/Previews" xcode
for ds in "$DEV/Xcode/"*DeviceSupport; do
  [ -d "$ds" ] && clean_old clean.device_support "$(basename "$ds")" "$ds" "$DS_DAYS"
done
clean_old  clean.device_logs    'iOS device logs'      "$DEV/Xcode/iOS Device Logs" 90 f
if task clean.sim_unavailable && have xcrun; then
  NU=$(xcrun simctl list devices unavailable 2>/dev/null | grep -c '(unavailable')
  if [ "$NU" -gt 0 ]; then
    if CLEAN; then
      s=$(kb "$DEV/CoreSimulator/Devices"); step 'Unavailable simulators'; run xcrun simctl delete unavailable
      a=$(kb "$DEV/CoreSimulator/Devices"); d=$((s - a)); [ "$d" -lt 0 ] && d=0
      account "$(_f 'Unavailable simulators (%s)' "$NU")" "$d"
    else info 'Unavailable simulators: %s' "$NU"; fi
  fi
fi
clean_dir  clean.sim_caches     'Simulator caches'     "$DEV/CoreSimulator/Caches"
clean_dir  clean.spm            'SwiftPM cache'        "$HOME/Library/Caches/org.swift.swiftpm"
clean_dir  clean.cocoapods      'CocoaPods cache'      "$HOME/Library/Caches/CocoaPods"
clean_dir  clean.carthage       'Carthage cache'       "$HOME/Library/Caches/org.carthage.CarthageKit"

if task clean.brew && have brew; then
  if CLEAN; then
    step 'Homebrew cleanup'
    OUT=$(brew cleanup -s --prune=7 2>&1); echo "$OUT" >>"$RAW"
    FR=$(echo "$OUT" | grep -o 'freed approximately [0-9.]*[KMGT]*B' | tail -1 | awk '{print $3}')
    if [ -n "$FR" ]; then account "$(_ 'Homebrew old versions & downloads')" "$(tokb "$FR")"; else ok 'Homebrew: nothing old to remove'; fi
  else
    s=$(kb "$(brew --cache 2>/dev/null)"); [ "$s" -gt 5120 ] && account "$(_ 'Homebrew downloads cache')" "$s"
  fi
fi
have npm  && measure_cmd clean.npm  'npm cache'      "$HOME/.npm/_cacache" npm cache verify
have yarn && clean_dir   clean.yarn 'Yarn cache'     "$HOME/Library/Caches/Yarn"
have pnpm && measure_cmd clean.pnpm 'pnpm store'     "$(pnpm store path 2>/dev/null || echo /nonexistent)" pnpm store prune
have pip3 && measure_cmd clean.pip  'pip cache'      "$HOME/Library/Caches/pip" pip3 cache purge
have uv   && measure_cmd clean.uv   'uv cache'       "$(uv cache dir 2>/dev/null || echo /nonexistent)" uv cache prune
have go   && measure_cmd clean.go   'Go build cache' "$(go env GOCACHE 2>/dev/null || echo /nonexistent)" go clean -cache

if task clean.logs; then
  OLDLOGS=$(find "$HOME/Library/Logs" -type f -mtime +30 -not -path "$LOGDIR/*" 2>/dev/null)
  if [ -n "$OLDLOGS" ]; then
    s=$(printf '%s\n' "$OLDLOGS" | tr '\n' '\0' | xargs -0 du -sk 2>/dev/null | awk '{s+=$1} END{print s+0}')
    CLEAN && printf '%s\n' "$OLDLOGS" | tr '\n' '\0' | xargs -0 rm -f 2>/dev/null
    [ "${s:-0}" -ge 1024 ] && account "$(_f 'Old logs & crash reports (%s files)' "$(cnt "$OLDLOGS")")" "$s"
  fi
fi
if task clean.quicklook && CLEAN; then run qlmanage -r cache; fi
if task clean.reports && [ "$DRY" = 0 ]; then find "$LOGDIR" -name 'macup_*' -mtime +"$KEEP_DAYS" -delete 2>/dev/null; fi

if task clean.trash; then
  s=$(kb "$HOME/.Trash")
  if [ "$s" -gt 0 ]; then
    if CLEAN; then find "$HOME/.Trash" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>>"$RAW"; s=$((s - $(kb "$HOME/.Trash"))); fi
    account "$(_ 'Trash')" "$s"
  fi
fi

project_roots(){ # never the home folder itself or anything above it
  echo "$PROJECT_DIRS" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | while IFS= read -r d; do
    d=$(expand "$d"); d=${d%/}
    case "$d" in ""|"$HOME") continue ;; esac
    case "$HOME/" in "$d"/*) continue ;; esac
    [ -d "$d" ] && echo "$d"
  done
}
if task clean.stale_node_modules; then
  step 'Looking for stale node_modules'
  STALE=""; SS=0
  while IFS= read -r root; do
    [ -z "$root" ] && continue
    while IFS= read -r nm; do
      [ -z "$nm" ] && continue
      case "${nm#"$root"}" in */.*|*/lib/node_modules) continue ;; esac   # hidden folders, global npm installs
      proj=$(dirname "$nm")
      recent=$(find "$proj" -maxdepth 3 \( -name node_modules -o -name .git \) -prune -o -type f -mtime -"$STALE_DAYS" -print 2>/dev/null | head -1)
      [ -n "$recent" ] && continue
      STALE="$STALE$nm"$'\n'; SS=$((SS + $(kb "$nm")))
    done <<EOF
$(find "$root" -maxdepth 5 -type d -name node_modules -prune 2>/dev/null)
EOF
  done <<EOF
$(project_roots)
EOF
  if [ -n "$STALE" ]; then
    CLEAN && printf '%s' "$STALE" | while IFS= read -r nm; do [ -n "$nm" ] && rm -rf "$nm"; done
    account "$(_f 'Stale node_modules (%s projects untouched for %s days; npm install brings them back)' "$(cnt "$STALE")" "$STALE_DAYS")" "$SS"
    printf '%s' "$STALE" | while IFS= read -r nm; do [ -n "$nm" ] && mdonly "$(tildify "$nm")"; done
  fi
fi
fi # WANT_CLN

# ================================================================ SIZES (never deleted)
if task check.sizes; then
  section "Not touched by macup"
  s=$(kb "$DEV/Xcode/Archives")
  if [ "$s" -gt 5242880 ]; then warn 'Xcode Archives: %s — delete old builds in Xcode → Organizer (keep ones you need to symbolicate crashes)' "$(hum "$s")"
  elif [ "$s" -gt 0 ]; then info 'Xcode Archives: %s' "$(hum "$s")"; fi
  s=$(kb "$DEV/CoreSimulator/Devices"); [ "$s" -gt 0 ] && info 'Simulator devices: %s (Xcode → Window → Devices and Simulators)' "$(hum "$s")"
  s=$(kb "$HOME/.pub-cache");          [ "$s" -gt 0 ] && info 'Flutter pub-cache: %s (full reset: dart pub cache clean)' "$(hum "$s")"
  s=$(kb "$HOME/.gradle/caches");      [ "$s" -gt 0 ] && info 'Gradle caches: %s' "$(hum "$s")"
  s=$(kb "$HOME/Library/Caches");      [ "$s" -gt 0 ] && info 'App caches (~/Library/Caches): %s — macOS trims these itself when space is low' "$(hum "$s")"
  if ! task clean.trash; then
    s=$(kb "$HOME/.Trash")
    if [ "$s" -gt 2097152 ]; then warn 'Trash: %s — empty it' "$(hum "$s")"; elif [ "$s" -gt 0 ]; then info 'Trash: %s' "$(hum "$s")"; fi
  fi
fi

# ================================================================ STARTUP
if task check.startup; then
  section "Startup items"
  AG=""; ORPH=""
  for f in "$HOME"/Library/LaunchAgents/*.plist /Library/LaunchAgents/*.plist /Library/LaunchDaemons/*.plist; do
    [ -f "$f" ] || continue
    b=$(basename "$f" .plist); case "$b" in com.apple.*) continue ;; esac
    AG="$AG$b"$'\n'
    prog=$(plutil -extract Program raw -o - "$f" 2>/dev/null || plutil -extract ProgramArguments.0 raw -o - "$f" 2>/dev/null)
    case "$prog" in /*) [ -e "$prog" ] || ORPH="$ORPH$(tildify "$f") → $(tildify "$prog")"$'\n' ;; esac
  done
  info 'Third-party background services: %s (full list in the report)' "$(cnt "$AG")"
  printf '%s' "$AG" | while IFS= read -r l; do [ -n "$l" ] && mdonly "$l"; done
  if [ -n "$ORPH" ]; then
    warn 'Orphaned launch items: %s point to programs that no longer exist (likely leftovers of deleted apps)' "$(cnt "$ORPH")"
    lines "$ORPH"
  fi
  info 'Login items: System Settings → General → Login Items & Extensions'
fi

# ================================================================ DEEP
if [ "$DEEP" = 1 ]; then
  section "Deep scan"
  step 'Measuring your home folder (can take a few minutes)'
  info 'Largest folders in your home:'
  du -sk "$HOME"/* "$HOME"/.[!.]* 2>/dev/null | sort -rn | head -12 | while read -r s p; do sub "$(hum "$s")  $(tildify "$p")"; done
  if [ -d "$HOME/Downloads" ]; then
    DL=$(find "$HOME/Downloads" -mindepth 1 -maxdepth 1 -mtime +90 2>/dev/null)
    if [ -n "$DL" ]; then
      s=$(printf '%s\n' "$DL" | tr '\n' '\0' | xargs -0 du -sk 2>/dev/null | awk '{s+=$1} END{print s+0}')
      info "Downloads older than 90 days: %s items, %s — review and delete what you don't need" "$(cnt "$DL")" "$(hum "$s")"
    fi
    BIG=$(find "$HOME/Downloads" -type f -size +1G 2>/dev/null | head -10)
    [ -n "$BIG" ] && { info 'Files over 1 GB in Downloads:'; printf '%s\n' "$BIG" | while IFS= read -r f; do sub "$(hum "$(kb "$f")")  $(tildify "$f")"; done; }
  fi
  step 'Scanning projects for build artifacts'
  ART=""
  while IFS= read -r root; do
    [ -z "$root" ] && continue
    ART="$ART$(find "$root" -maxdepth 6 -type d \( -name node_modules -o -name Pods -o -name .build -o -name .dart_tool -o -name DerivedData \) -prune -print 2>/dev/null)"$'\n'
  done <<EOF
$(project_roots)
EOF
  if [ -n "$(printf '%s' "$ART" | grep .)" ]; then
    TOP=$(printf '%s' "$ART" | grep . | while IFS= read -r a; do echo "$(kb "$a") $a"; done | sort -rn)
    TS=$(printf '%s\n' "$TOP" | awk '{s+=$1} END{print s+0}')
    info 'Project build artifacts (node_modules, Pods, .build, .dart_tool): %s total; largest:' "$(hum "$TS")"
    printf '%s\n' "$TOP" | head -8 | while read -r s p; do sub "$(hum "$s")  $(tildify "$p")"; done
    task clean.stale_node_modules || info "Tip: enable clean.stale_node_modules in the config to remove node_modules from projects you haven't touched in %s days" "$STALE_DAYS"
  elif [ -z "$(project_roots)" ]; then
    info 'No project folders found. Set project_dirs in %s' "$(tildify "$CONF")"
  else
    info 'No build artifacts in: %s' "$(project_roots | while IFS= read -r d; do tildify "$d"; done | paste -sd ',' - | sed 's/,/, /g')"
  fi
fi

# ================================================================ TRENDS + SUMMARY
FREE_AFTER=$(df -k /System/Volumes/Data 2>/dev/null | awk 'NR==2{print $4}'); FREE_AFTER=${FREE_AFTER:-0}
PCT2=$(( FREE_AFTER * 100 / D_TOTAL ))

if task check.trends && [ -n "$PREV" ]; then
  section "Since last run"
  IFS=, read -r P_TS P_MODE P_FREE P_TOT P_MEM P_SWAP P_CYC P_MAX P_UPD P_FREED P_WARN <<EOF
$PREV
EOF
  DFREE=$((FREE_AFTER - ${P_FREE:-$FREE_AFTER}))
  if [ "$DFREE" -lt -20971520 ]; then warn 'Free space: %s since %s — something is filling the disk (try: macup check --deep)' "$(hum "$DFREE")" "$P_TS"
  else info 'Free space: %s since %s' "$( [ "$DFREE" -ge 0 ] && printf '+')$(hum "$DFREE")" "$P_TS"; fi
  [ -n "$BMAX" ] && [ -n "$P_MAX" ] && [ "$P_MAX" != "$BMAX" ] && info 'Battery capacity: %s%% → %s%%' "$P_MAX" "$BMAX"
  [ -n "$BCYC" ] && [ -n "$P_CYC" ] && [ "$P_CYC" != "$BCYC" ] && info 'Battery cycles: +%s' "$((BCYC - P_CYC))"
  info 'Full history: macup history'
fi

NEWER=""
if task check.self_update; then
  case "$MACUP_REPO" in __*) ;; *)
    STAMPF="$STATE_DIR/last_version_check"
    if [ ! -f "$STAMPF" ] || [ -n "$(find "$STAMPF" -mtime +6 2>/dev/null)" ]; then
      RV=$(curl -fsS --max-time 4 "$MACUP_RAW/macup" 2>/dev/null | sed -n 's/^MACUP_VERSION="\(.*\)"/\1/p' | head -1)
      if [ -n "$RV" ]; then echo "$RV" >"$STAMPF"; else touch "$STAMPF"; fi
    fi
    RV=$(cat "$STAMPF" 2>/dev/null)
    ver_gt "$RV" "$MACUP_VERSION" && NEWER="$RV"
  ;; esac
fi

T=$SECONDS; TIME="$((T / 60))m $((T % 60))s"
echo "$(date '+%Y-%m-%d %H:%M'),$MODE,$FREE_AFTER,$D_TOTAL,${MEMFREE:-},${SWAP:-0},${BCYC:-},${BMAX:-},${#UPDATED[@]},$FREED,${#WARN[@]}" >>"$HISTORY"

SUM=$(mktemp "${TMPDIR:-/tmp}/macup.XXXXXX")
{
  echo "# $(_f 'macup report — %s' "$(date '+%Y-%m-%d %H:%M')")"
  echo
  _f 'Mode: %s · macup %s · took %s' "$MODE" "$MACUP_VERSION" "$TIME"; echo
  echo
  echo "## $(_ 'Summary')"
  echo
  if [ ${#UPDATED[@]} -gt 0 ]; then echo "- **$(_f 'Updated (%s):' "${#UPDATED[@]}")**"; for u in "${UPDATED[@]}"; do echo "    - $u"; done
  elif UPD; then echo "- $(_ 'Updates: everything was already up to date')"; fi
  if CLEAN; then echo "- **$(_f 'Freed: %s' "$(hum "$FREED")")**"; elif WANT_CLN && [ "$POTENTIAL" -gt 0 ]; then echo "- $(_f 'Could free: ~%s' "$(hum "$POTENTIAL")")"; fi
  echo "- $(_f 'Free disk space: %s (%s%%), was %s' "$(hum "$FREE_AFTER")" "$PCT2" "$(hum "$FREE_BEFORE")")"
  if [ ${#WARN[@]} -gt 0 ]; then echo "- **$(_f 'Needs attention (%s):' "${#WARN[@]}")**"; for w in "${WARN[@]}"; do echo "    - $w"; done
  else echo "- $(_ 'Needs attention: nothing')"; fi
  [ -n "$NEWER" ] && echo "- $(_f 'macup %s is available: macup self-update' "$NEWER")"
  echo
  _f 'Command log: %s' "\`$(tildify "$RAW")\`"; echo
} >"$SUM"
cat "$SUM" "$BODY" >"$REPORT"; rm -f "$SUM"

printf '%s\n%s━━━━━━━━━━━━━━━━ %s ━━━━━━━━━━━━━━━━%s\n' "$CL" "$B" "$(_ 'Summary')" "$N"
if [ ${#UPDATED[@]} -gt 0 ]; then
  printf '  %s%s%s\n' "$G" "$(_f 'Updated: %s' "${#UPDATED[@]}")" "$N"; for u in "${UPDATED[@]}"; do printf '    · %s\n' "$u"; done
elif UPD; then printf '  %s%s%s\n' "$G" "$(_ 'Updates: everything was already up to date')" "$N"; fi
if CLEAN; then printf '  %s%s%s\n' "$G" "$(_f 'Freed: %s' "$(hum "$FREED")")" "$N"
elif WANT_CLN && [ "$POTENTIAL" -gt 0 ]; then printf '  %s\n' "$(_f 'Could free: ~%s  (to free it: macup all)' "$(hum "$POTENTIAL")")"; fi
printf '  %s\n' "$(_f 'Free disk space: %s (%s%%)' "$(hum "$FREE_AFTER")" "$PCT2")"
if [ ${#WARN[@]} -gt 0 ]; then
  printf '  %s%s%s\n' "$Y" "$(_f 'Needs attention: %s' "${#WARN[@]}")" "$N"; for w in "${WARN[@]}"; do printf '    %s!%s %s\n' "$Y" "$N" "$w"; done
else printf '  %s%s%s\n' "$G" "$(_ 'Needs attention: nothing')" "$N"; fi
[ -n "$NEWER" ] && printf '  %s%s%s\n' "$C" "$(_f 'macup %s is available: macup self-update' "$NEWER")" "$N"
printf '  %s%s%s\n' "$D" "$(_f 'Report: %s · %s' "$(tildify "$REPORT")" "$TIME")" "$N"
printf '  %s%s%s\n' "$D" "$(_ 'Menu: macup · trends: macup history · help: macup help')" "$N"
