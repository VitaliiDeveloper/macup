  AR=$(tl 60 brew autoremove --dry-run 2>/dev/null | grep -v '^==>' | grep . | paste -sd, - | sed 's/,/, /g')
  [ -n "$AR" ] && cand clean.brew_autoremove 2 "$(_f 'Homebrew packages nothing needs any more: %s' "$AR")" 0 cmd brewauto
fi

# --- older patch versions of Node, Ruby, Python. The newest of each line stays, and so does
# every version named in a global setting or in a project's pin file (.nvmrc, .tool-versions, …).
if task_allowed clean.old_versions; then
  PINSRC=$( { cat "$HOME/.rbenv/version" "$HOME/.pyenv/version" "$HOME/.tool-versions" "$HOME/.config/mise/config.toml" 2>/dev/null; echo
    find "$HOME/.nvm/alias" -type f 2>/dev/null | tr '\n' '\0' | xargs -0 cat 2>/dev/null   # default → lts/iron → x.y.z
    # Volta's default Node; fnm's aliases and the version each open shell uses are links to the version folder
    cat "$HOME/.volta/tools/user/platform.json" 2>/dev/null; echo
    for a in "$HOME/.local/share/fnm/aliases"/* "$HOME/.fnm/aliases"/* "$HOME/.local/state/fnm_multishells"/*; do [ -L "$a" ] && readlink "$a"; done
    # pipx, uv tools, poetry, pipenv, virtualenvwrapper, hatch
    find "$HOME/.local/pipx/venvs" "$HOME/.local/share/uv/tools" "$HOME/Library/Caches/pypoetry/virtualenvs" \
      "$HOME/.local/share/virtualenvs" "$HOME/.virtualenvs" "$HOME/Library/Application Support/hatch/env/virtual" -maxdepth 3 \
      -name pyvenv.cfg 2>/dev/null | tr '\n' '\0' | xargs -0 cat 2>/dev/null
    project_roots | while IFS= read -r r; do
      find "$r" -maxdepth 4 \( -name node_modules -o -name .git \) -prune -o -type f \( -name .nvmrc -o -name .node-version \
        -o -name .ruby-version -o -name .python-version -o -name .tool-versions -o -name mise.toml -o -name .mise.toml -o -name pyvenv.cfg \) -print 2>/dev/null
    done | head -2000 | tr '\n' '\0' | xargs -0 cat 2>/dev/null
    # package.json: "volta": {"node": "20.5.0"} and "engines": {"node": "20.5.0"}; never its dependency versions
    project_roots | while IFS= read -r r; do
      find "$r" -maxdepth 4 \( -name node_modules -o -name .git \) -prune -o -type f -name package.json -print 2>/dev/null
    done | head -2000 | tr '\n' '\0' | xargs -0 grep -hE '"node"[[:space:]]*:' 2>/dev/null
  } )
  PINS=" $(printf '%s\n' "$PINSRC" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | sort -u | tr '\n' ' ') "
  # a pin without the patch ("20.5" in an .nvmrc) means the newest installed 20.5.x
  PINS2=" $(printf '%s\n' "$PINSRC" | grep -oE '(^|[^0-9.])[0-9]+\.[0-9]+([^0-9.]|$)' | grep -oE '[0-9]+\.[0-9]+' | sort -u | tr '\n' ' ') "
  old_versions(){ # dir series(1 = major, 2 = major.minor) → older patch versions that nothing pins
    for e in "$1"/*; do [ -d "$e" ] && printf '%s\n' "${e##*/}"; done | grep -E '^v?[0-9]+\.[0-9]+\.[0-9]+$' \
      | awk -v s="$2" '{v=$0; sub(/^v/,"",v); split(v,a,"."); print (s==1 ? a[1] : a[1]"."a[2]), v, $0}' \
      | sort -k1,1 -k2,2V | awk '{if(p==$1) print last; p=$1; last=$3}' | while IFS= read -r n; do
        [ -L "$1/$n" ] && continue
        case "$PINS" in *" ${n#v} "*) continue ;; esac
        mm=${n#v}; mm=${mm%.*}
        case "$PINS2" in *" $mm "*)
          [ "$(for e in "$1"/*; do printf '%s\n' "${e##*/}"; done | sed 's/^v//' | grep -E "^${mm/./\\.}\.[0-9]+$" | sort -V | tail -1)" = "${n#v}" ] && continue ;;
        esac
        [ -n "$(ls -A "$1/$n/envs" 2>/dev/null)" ] && continue   # pyenv virtualenvs live inside
        echo "$1/$n"
      done
  }
  vm(){ # tool manager dir series
    local l; l=$(old_versions "$3" "$4"); [ -z "$l" ] && return 0
    CL_KEY="ver|$3" cand clean.old_versions 2 "$(_f 'Older %s versions (%s): %s' "$1" "$2" "$(echo "$l" | sed 's|.*/v*||' | paste -sd ',' - | sed 's/,/, /g')")" "$(kbl "$l")" rm "$l"
  }
  vm Node.js nvm   "$HOME/.nvm/versions/node" 1
  vm Node.js fnm   "$HOME/.local/share/fnm/node-versions" 1
  vm Node.js fnm   "$HOME/.fnm/node-versions" 1
  vm Node.js Volta "$HOME/.volta/tools/image/node" 1
  vm Ruby    rbenv "$HOME/.rbenv/versions"    2
  vm Python  pyenv "$HOME/.pyenv/versions"    2
  for m in "$HOME/.local/share/mise/installs" "$HOME/.asdf/installs"; do
    for t in "$m"/*; do [ -d "$t" ] || continue; s=2; [ "${t##*/}" = node ] && s=1
      vm "${t##*/}" "$(basename "$(dirname "$m")" | sed 's/^\.//')" "$t" "$s"; done
  done
fi

# --- old browser builds left by Playwright and Puppeteer; the newest of each stays
if task_allowed clean.playwright; then
  old_builds(){ for e in "$1"/*; do [ -d "$e" ] && printf '%s\n' "${e##*/}"; done | grep -E '^.+-[0-9][0-9.]*$' | sed -E 's/^(.+)-([0-9][0-9.]*)$/\1 \2 &/' \
      | sort -k1,1 -k2,2V | awk '{if(p==$1) print last; p=$1; last=$3}' | sed "s|^|$1/|"; }
  cover "$HOME/Library/Caches/ms-playwright"; cover "$HOME/Library/Caches/ms-playwright-go"   # browsers in use stay
  L=""; for d in "$HOME/Library/Caches/ms-playwright" "$HOME/.cache/puppeteer"/*; do [ -d "$d" ] && L="$L$(old_builds "$d")"$'\n'; done
  # Cypress keeps every version it ever ran, about 600 MB each
  CY="$HOME/Library/Caches/Cypress"; cover "$CY"
  [ -d "$CY" ] && [ ! -L "$CY" ] && L="$L$(for e in "$CY"/*; do [ -d "$e" ] && [ ! -L "$e" ] && printf '%s\n' "${e##*/}"; done | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | sed '$d' | sed "s|^|$CY/|")"$'\n'
  L=$(printf '%s' "$L" | grep .)
  [ -n "$L" ] && CL_KEY=browsers cand clean.playwright 2 "$(_f 'Old Playwright, Puppeteer and Cypress builds (%s)' "$(cnt "$L")")" "$(kbl "$L")" rm "$L"
fi

# --- AI tools: only leftovers. Chat history, sessions and databases are never touched.
if task_allowed clean.ai_tools; then
L=$(find "$HOME/.codex/.tmp" -mindepth 1 -maxdepth 1 -type d -name 'git-*' -mtime +7 2>/dev/null)
[ -n "$L" ] && [ "$(kbl "$L")" -ge 1024 ] && CL_KEY=codex_tmp cand clean.ai_tools 1 "$(_f 'Codex temporary git clones (%s, older than 7 days)' "$(cnt "$L")")" "$(kbl "$L")" rm "$L"
L=$(find "$HOME/.cache/codex-runtimes" -mindepth 1 -maxdepth 1 -type d -name 'codex-runtime-install-*' -mtime +1 2>/dev/null)
[ -n "$L" ] && CL_KEY=codex_rt cand clean.ai_tools 1 "$(_ 'Unfinished Codex runtime downloads')" "$(kbl "$L")" rm "$L"
# agy update keeps the replaced binary next to the new one
L=$(find "$HOME/.local/bin" -maxdepth 1 -type f -name 'agy.*.old' 2>/dev/null)
[ -n "$L" ] && CL_KEY=agy_old cand clean.ai_tools 1 "$(_ 'Old Antigravity CLI versions left by its updates')" "$(kbl "$L")" rm "$L"
fi

# --- editors and Electron apps (ELECTRON_APPS), browsers (BROWSERS)
dirs_in(){ # base folder, list separated by | or ; → the ones that exist, one per line
  local d; echo "$2" | tr '|;' '\n\n' | while IFS= read -r d; do
    [ -n "$d" ] && [ -d "$1/$d" ] && [ ! -L "$1/$d" ] && echo "$1/$d"; done; }
task_allowed clean.editors && while IFS='|' read -r folder name; do
  A="$HOME/Library/Application Support/$folder"
  L=$(for b in "$A" "$A/Default" "$A/Partitions/"* "$A/Default/Partitions/"*; do
    [ -d "$b" ] && [ ! -L "$b" ] && dirs_in "$b" "$ELECTRON_CACHES"; done); [ -n "$L" ] || continue
  s=$(kbl "$L"); [ "$s" -lt 5120 ] && continue
  # Application Support/Codex belongs to ChatGPT.app, so the app name alone misses it
  cand clean.editors 1 "$(_f '%s caches' "$name")" "$s" empty "$L" "/$name.app/Contents/|user-data-dir=$A( --|/|$)"
done <<EOF2
$ELECTRON_APPS
EOF2
task_allowed clean.browsers && while IFS='|' read -r name app dirs; do   # Safari's cache needs Full Disk Access; skipped
  L=$(dirs_in "$HOME/Library/Caches" "$dirs"); [ -n "$L" ] || continue
  s=$(kbl "$L"); [ "$s" -lt 5120 ] && continue
  cand clean.browsers 3 "$(_f '%s cache' "$name")" "$s" empty "$L" "/$app.app/Contents/"
done <<EOF2
$BROWSERS
EOF2

# --- any other Chromium, Electron or Firefox cache, found by its layout instead of a name in the tables:
# in Application Support a cache folder (ELECTRON_CACHES) next to Chromium's own files; in ~/Library/Caches the
# name is enough (cache2 is Firefox's). A browser (History next to it) is aggressive, an app safe. Never inside an
# .app or an updater's folder: ShipIt and Sparkle keep downloaded updates there until they are installed.
# Skipped while any process has a file open in the app's folders (lsof); the tables still give the known names.
if have python3 && { task_allowed clean.editors || task_allowed clean.browsers; }; then
  GEN=$(NAMES=$ELECTRON_CACHES APPS=$ELECTRON_APPS BRS=$BROWSERS COVERED=$COVERED python3 - "$HOME/Library/Application Support" "$HOME/Library/Caches" <<'PY' 2>/dev/null
import os, sys
A, K = sys.argv[1], sys.argv[2]
names = set(os.environ["NAMES"].split("|"))
covered = [c for c in os.environ["COVERED"].split("\n") if c]
apps = dict(l.split("|", 1) for l in os.environ["APPS"].split("\n") if "|" in l)
browsers = {d: f[0] for f in (l.split("|") for l in os.environ["BRS"].split("\n")) if len(f) > 2 for d in f[2].split(";")}
has = lambda p, n: os.path.exists(os.path.join(p, n))
def chromium(p):
    return has(p, "Local State") or (has(p, "Preferences") and any(has(p, n) for n in ("Cookies", "TransportSecurity", "Network Persistent State", "DIPS")))
groups = {}
def record(root, path):
    if any(path == c or path.startswith(c + "/") for c in covered): return
    top = os.path.relpath(path, root).split(os.sep)[0]
    prof = os.path.dirname(path)
    aprof = prof if root == A else os.path.join(A, os.path.relpath(prof, K))
    udr = aprof
    while udr.startswith(A + os.sep) and not has(udr, "Local State"): udr = os.path.dirname(udr)
    key = os.path.relpath(udr, A) if udr.startswith(A + os.sep) else top
    if key.endswith("/User Data"): key = key[: -len("/User Data")]
    if top in apps: kind, name = "app", apps[top]
    else:
        name = browsers.get(key) or browsers.get(top) or (key.replace("/", " ") if key.count("/") < 2 else top)
        browser = path.endswith("/cache2") or has(aprof, "History") or has(aprof, "Default/History") or has(udr, "Default/History")
        kind = "browser" if browser else "app"
    g = groups.setdefault((kind, name), (set(), {os.path.join(A, top), os.path.join(K, top)}))
    g[0].add(path)
for root in (A, K):
    for dp, dns, _ in os.walk(root):
        depth = 0 if dp == root else os.path.relpath(dp, root).count(os.sep) + 1
        keep = []
        for d in dns:
            p = os.path.join(dp, d)
            if os.path.islink(p) or d.endswith((".app", ".ShipIt")) or d == "org.sparkle-project.Sparkle": continue
            if depth == 0 and (d.startswith("com.apple.") or d == "macup"): continue
            if d in names or (d == "cache2" and root == K):
                if depth > 0 and (root == K or (d != "cache2" and chromium(dp))): record(root, p)
                continue
            if depth < 5: keep.append(d)
        dns[:] = keep
for (kind, name), (paths, opened) in sorted(groups.items()):
    print("3" if kind == "browser" else "1", kind, name, "\x1f".join(sorted(opened)), "\x1f".join(sorted(paths)), sep="\t")
PY
)
  while IFS=$'\t' read -r lv kind name opened paths; do
    [ -n "$paths" ] || continue
    L=$(printf '%s' "$paths" | tr '\037' '\n'); O=$(printf '%s' "$opened" | tr '\037' '\n')
    s=$(kbl "$L"); [ "$s" -lt 5120 ] && continue
    if [ "$kind" = browser ]; then id=clean.browsers; lbl=$(_f '%s cache' "$name"); else id=clean.editors; lbl=$(_f '%s caches' "$name"); fi
    cand_more "$lbl" "$lv" "$s" "$L" "$O" || cand "$id" "$lv" "$lbl" "$s" empty "$L" "" "" "$O"
  done <<EOF2
$GEN
EOF2
fi

# --- other big folders in ~/Library/Caches (100 MB+), except macOS's own and what is already listed above
if task_allowed clean.app_caches; then
  kb_get "$HOME/Library/Caches"   # waits for its walk
  LC=""; for ((i = 0; i < KBP_N; i++)); do [ "${KBP_PATH[i]}" = "$HOME/Library/Caches" ] && LC="$BODY.du.$i"; done
  { if [ -n "$LC" ]; then sed '$d' "$LC"; else du -k -d 1 "$HOME/Library/Caches" 2>/dev/null | sed '$d'; fi; } | sort -rn | while IFS="$(printf '\t')" read -r s e; do
    [ "$s" -lt 102400 ] && break
    b=${e##*/}; [ -d "$e" ] && [ ! -L "$e" ] || continue
    case "$b" in com.apple.*|Adobe\ Camera\ Raw*|*.ShipIt) continue ;; esac
    printf '%s' "$COVERED" | grep -xF -- "$e" >/dev/null && continue   # no grep -q: with pipefail an early exit reads as "not covered"
    printf '%s' "$COVERED" | grep -F -- "$e/" >/dev/null && continue
    # not a cache whatever the folder is called: Poetry keeps its virtualenvs in ~/Library/Caches/pypoetry
    [ -n "$(find "$e" -maxdepth 3 -name pyvenv.cfg -print 2>/dev/null | head -1)" ] && continue
    printf '%s\t%s\n' "$s" "$e"
  done > "$BODY.caches"
  while IFS="$(printf '\t')" read -r s e; do
    cand clean.app_caches 3 "$(_f 'App cache: %s' "${e##*/}")" "$s" empty "$e"
  done < "$BODY.caches"; rm -f "$BODY.caches"
fi

leftovers_cands

# what a plain `macup all` would free, and what more is there
settle
[ "$DRY" = 1 ] && mark_busy
for ((i = 0; i < C_N; i++)); do
  visible "$i" && [ "${C_BUSY[i]:-0}" = 0 ] || continue
  case "${C_TASK[i]}" in clean.orphan_*) continue ;; esac   # counted together below: their entries can share a folder
  if [ "${C_AUTO[i]}" = 1 ] && [ "${C_LVL[i]}" -le "$LEVEL" ]; then POT_AUTO=$((POT_AUTO + C_KB[i])); else POT_MORE=$((POT_MORE + C_KB[i])); fi
done
POT_MORE=$((POT_MORE + $(lo_total)))
if CLEAN && [ -n "$PICK" ]; then
  # --pick: the keys a check gave, chosen by a person in another program; that choice is the confirmation
  section "Cleanup"
  for ((i = 0; i < C_N; i++)); do case "$PICK" in *",${C_KEY[i]},"*) exec_cand "$i"; PICK=${PICK/,${C_KEY[i]},/,} ;; esac; done
  GONE=$(printf '%s' "$PICK" | tr ',' '\n' | grep . | paste -sd, - | sed 's/,/, /g')
  [ -n "$GONE" ] && err 'Not cleaned, no longer there: %s — run macup check again' "$GONE"
elif CLEAN; then
  section "Cleanup"
  for ((i = 0; i < C_N; i++)); do [ "${C_AUTO[i]}" = 1 ] && [ "${C_LVL[i]}" -le "$LEVEL" ] && exec_cand "$i"; done
  [ "$DID_CLEAN" = 0 ] && info 'Nothing to clean at level %s' "$(lvl_word "$LEVEL")"
else
  section "What can be cleaned"
  list_cands
fi
fi # WANT_CLN

# ================================================================ SIZES (never deleted)
if task check.sizes; then
  section "Not touched by macup"
  kb_get "$DEV/Xcode/Archives"; s=$KB
  if [ "$s" -gt 5242880 ]; then warn 'Xcode Archives: %s — delete old builds in Xcode → Organizer (keep ones you need to symbolicate crashes)' "$(hum "$s")"
  elif [ "$s" -gt 0 ]; then info 'Xcode Archives: %s' "$(hum "$s")"; fi
  kb_get "$DEV/CoreSimulator/Devices"; s=$KB; [ "$s" -gt 0 ] && info 'Simulator devices: %s (Xcode → Window → Devices and Simulators)' "$(hum "$s")"
  s=$(kb "$HOME/.pub-cache");          [ "$s" -gt 0 ] && info 'Flutter pub-cache: %s (full reset: dart pub cache clean)' "$(hum "$s")"
  s=$(kbl "$HOME/.codex/sessions"$'\n'"$HOME/.codex/archived_sessions"$'\n'"$(ls -d "$HOME/.codex/"*.sqlite 2>/dev/null)")
  [ "$s" -ge 102400 ] && info 'Codex chat history: %s (not a cache; delete old chats in Codex itself)' "$(hum "$s")"
  s=$(kbl "$HOME/.cache/huggingface"$'\n'"$HOME/.ollama/models"$'\n'"$HOME/.lmstudio/models")
  [ "$s" -ge 102400 ] && info 'AI models (Hugging Face, Ollama, LM Studio): %s' "$(hum "$s")"
  s=$(kbl "$HOME/Library/Android/sdk"$'\n'"$HOME/.android/avd")
  [ "$s" -ge 102400 ] && info 'Android SDK and emulators: %s (Android Studio → SDK Manager, Device Manager)' "$(hum "$s")"
  kb_get "$HOME/Library/Caches"; s=$KB; [ "$s" -gt 0 ] && info 'App caches (~/Library/Caches): %s — macOS trims these itself when space is low' "$(hum "$s")"
  # backups of iPhones and iPads made in Finder; Docker Desktop's disk image only grows (du counts what it really takes)
  s=$(kb "$HOME/Library/Application Support/MobileSync/Backup")
  [ "$s" -ge 102400 ] && info 'iPhone and iPad backups: %s (Finder → your device → Manage Backups)' "$(hum "$s")"
  s=$(kbl "$(ls -d "$HOME/Library/Containers/com.docker.docker/Data/vms"/*/data/Docker.raw 2>/dev/null)")
  [ "$s" -ge 102400 ] && info 'Docker disk image: %s (Docker Desktop → Settings → Resources; it shrinks after: docker system prune)' "$(hum "$s")"
  # virtual machines are whole disks: only their app knows which one is still needed
  s=$(kbl "$HOME/.colima"$'\n'"$HOME/.lima"$'\n'"$HOME/.local/share/containers/podman/machine"$'\n'"$HOME/.minikube"$'\n'"$HOME/Parallels"$'\n'"$HOME/Virtual Machines.localized")
  [ "$s" -ge 102400 ] && info 'Virtual machines (Colima, Lima, Podman, minikube, Parallels, VMware): %s — delete the ones you no longer use in their own app' "$(hum "$s")"
  # a crashed program can leave a copy of its memory in /cores, gigabytes each, and nothing ever removes them
  s=$(kb /cores); [ "$s" -ge 102400 ] && warn 'Core dumps in /cores: %s — leftovers of crashed programs; remove them with: sudo rm /cores/core.*' "$(hum "$s")"
  if [ -d "$HOME/.Trash" ] && ! ls "$HOME/.Trash" >/dev/null 2>&1; then
    task clean.trash || info 'Trash: cannot be read — give your terminal Full Disk Access (System Settings → Privacy & Security)'
  elif ! task clean.trash; then
    s=$(kb "$HOME/.Trash")
    if [ "$s" -gt 2097152 ]; then warn 'Trash: %s — empty it' "$(hum "$s")"; elif [ "$s" -gt 0 ]; then info 'Trash: %s' "$(hum "$s")"; fi
  fi
fi

# ================================================================ VIDEO & PHOTO (measured only)
# Their caches are rebuilt only by re-rendering, which can take hours, so macup only shows
# where the space is and the app's own button to clear it. Folders are read only if the app is installed.
if task check.creative; then
  section "Video & photo"
  if [ -d "/Applications/Final Cut Pro.app" ] && [ -d "$HOME/Movies" ]; then
    s=$(kbl "$(find "$HOME/Movies" -maxdepth 4 -type d -name 'Render Files' -path '*.fcpbundle/*' -prune 2>/dev/null)")
    [ "$s" -ge 102400 ] && info 'Final Cut Pro render files: %s — Final Cut: File → Delete Generated Library Files' "$(hum "$s")"
  fi
  s=$(kbl "$HOME/Library/Application Support/Adobe/Common/Media Cache Files"$'\n'"$HOME/Library/Application Support/Adobe/Common/Media Cache")
  [ "$s" -ge 102400 ] && info 'Adobe media cache (Premiere, After Effects): %s — Premiere: Settings → Media Cache → Delete' "$(hum "$s")"
  if [ -d "/Applications/DaVinci Resolve" ]; then
    s=$(kb "$HOME/Movies/CacheClip")
    [ "$s" -ge 102400 ] && info 'DaVinci Resolve render cache: %s — Resolve: Playback → Delete Render Cache' "$(hum "$s")"
  fi
  if ls -d /Applications/Adobe\ Lightroom\ Classic* >/dev/null 2>&1 && [ -d "$HOME/Pictures" ]; then
    s=$(kbl "$(find "$HOME/Pictures" -maxdepth 4 -type d -name '*Previews.lrdata' -prune 2>/dev/null)")
    [ "$s" -ge 102400 ] && info 'Lightroom Classic previews: %s — Lightroom: Library → Previews → Discard 1:1 Previews' "$(hum "$s")"
  fi
  s=$(kbl "$(ls -d "$HOME/Library/Caches/Adobe Camera Raw"* 2>/dev/null)")
  [ "$s" -ge 102400 ] && info 'Camera Raw cache: %s — Photoshop: Settings → Camera Raw → Performance → Purge Cache' "$(hum "$s")"
fi

# ================================================================ STARTUP
if task check.startup; then
  section "Startup items"
  leftovers_scan
  AG=""
  for f in "$HOME"/Library/LaunchAgents/*.plist "$LO_SYS"/LaunchAgents/*.plist "$LO_SYS"/LaunchDaemons/*.plist; do
    [ -f "$f" ] || continue
    b=$(basename "$f" .plist); case "$b" in com.apple.*) continue ;; esac
    AG="$AG$b"$'\n'
  done
  info 'Third-party background services: %s (full list in the report)' "$(cnt "$AG")"
  printf '%s' "$AG" | while IFS= read -r l; do [ -n "$l" ] && mdonly "$l"; done
  LO=""
  for ((i = 0; i < O_N; i++)); do
    case "${O_REASON[i]}" in
      broken)  info '%s cannot be read (not a valid plist)' "$(tildify "${O_PLIST[i]}")"; continue ;;
      gone)    r=$(_ 'app is not installed') ;;
      missing) r=$(_ 'its program is gone') ;;
      empty)   r=$(_ 'empty file') ;;
    esac
    LO="$LO${O_NAME[i]} · ${O_LABEL[i]:-$(basename "${O_PLIST[i]}" .plist)} — $r"$'\n'
    [ "${O_SYS[i]}" = 1 ] && { ! lo_interactive || ! lo_sys_ok "$i"; } && LO="$LO$(sudo_cmds "$i" | sed 's/^/    /')"$'\n'
  done
  if [ -n "$LO" ]; then
    warn 'Leftovers of deleted apps: %s (macup check lets you pick them)' "$(cnt "$LO")"
    lines "$LO"
  fi
  BS=$(btm_stale)
  if [ -n "$BS" ]; then
    warn 'Login items that point to deleted apps: %s — turn them off in System Settings → General → Login Items' "$(cnt "$BS")"
    lines "$BS"
  fi
  info 'Login items: System Settings → General → Login Items & Extensions'
fi

# ================================================================ DEEP
if [ "$DEEP" = 1 ]; then
  section "Deep scan"
  step 'Measuring your home folder (can take a few minutes)'
  info 'Largest folders in your home:'
  du -sk "$HOME"/* "$HOME"/.[!.]* 2>/dev/null | sort -rn | head -12 | while read -r s p; do sub "$(hum "$s")  $(tildify "$p")"; done
  info 'Largest folders in Application Support (mostly app data, not caches):'
  du -sk "$HOME/Library/Application Support"/* 2>/dev/null | sort -rn | head -10 | while read -r s p; do sub "$(hum "$s")  ${p##*/}"; done
  if [ -d "$HOME/Downloads" ]; then
    DL=$(find "$HOME/Downloads" -mindepth 1 -maxdepth 1 -mtime +90 2>/dev/null)
    if [ -n "$DL" ]; then
      s=$(printf '%s\n' "$DL" | tr '\n' '\0' | xargs -0 du -sk 2>/dev/null | awk '{s+=$1} END{print s+0}')
      info "Downloads older than 90 days: %s items, %s — review and delete what you don't need" "$(cnt "$DL")" "$(hum "$s")"
    fi
    BIG=$(find "$HOME/Downloads" -type f -size +1G 2>/dev/null | head -10)
    [ -n "$BIG" ] && { info 'Files over 1 GB in Downloads:'; printf '%s\n' "$BIG" | while IFS= read -r f; do sub "$(hum "$(kb "$f")")  $(tildify "$f")"; done; }
  fi
  step 'Scanning projects for build artifacts'
  ART=""
  while IFS= read -r root; do
    [ -z "$root" ] && continue
    # target and build are common names: only next to the build file that makes them (Cargo, Maven, Gradle)
    ART="$ART$(find "$root" -maxdepth 6 -type d \( -name node_modules -o -name Pods -o -name .build -o -name .dart_tool -o -name DerivedData -o -name .next -o -name .venv \
      -o \( -name target -exec test -e {}/../Cargo.toml -o -e {}/../pom.xml \; \) \
      -o \( -name build -exec test -e {}/../build.gradle -o -e {}/../build.gradle.kts \; \) \) -prune -print 2>/dev/null)"$'\n'
  done <<EOF
$(project_roots)
EOF
  if [ -n "$(printf '%s' "$ART" | grep .)" ]; then
    TOP=$(printf '%s' "$ART" | grep . | while IFS= read -r a; do echo "$(kb "$a") $a"; done | sort -rn)
    TS=$(printf '%s\n' "$TOP" | awk '{s+=$1} END{print s+0}')
    info 'Project build artifacts (node_modules, Pods, .build, .dart_tool, .next, .venv, Rust and Maven target, Gradle build): %s total; largest:' "$(hum "$TS")"
    printf '%s\n' "$TOP" | head -8 | while read -r s p; do sub "$(hum "$s")  $(tildify "$p")"; done
    task clean.stale_node_modules || info "Tip: enable clean.stale_node_modules in the config to remove node_modules from projects you haven't touched in %s days" "$STALE_DAYS"
  elif [ -z "$(project_roots)" ]; then
    info 'No project folders found. Set project_dirs in %s' "$(tildify "$CONF")"
  else
    info 'No build artifacts in: %s' "$(project_roots | while IFS= read -r d; do tildify "$d"; done | paste -sd ',' - | sed 's/,/, /g')"
  fi
fi

# ================================================================ PICK (interactive check)
if [ "$DRY" = 1 ] && [ "${C_N:-0}" -gt 0 ] && [ -t 0 ] && [ -t 1 ] && [ $((POT_AUTO + POT_MORE)) -gt 0 ]; then
  echo
  CHOSEN=$(pick)
  if [ -n "$CHOSEN" ]; then
    RISKY=0; for i in $CHOSEN; do { [ "${C_LVL[i]}" = 3 ] || [ "${C_AUTO[i]}" = 0 ]; } && RISKY=1; done
    if [ "$RISKY" = 1 ]; then
      c=$(ask "$(_ 'This includes aggressive or opt-in items: apps may sign you out or rebuild caches slowly. Quit those apps first. Continue? [y/N] ')")
      case "$c" in y|Y|т|Т|д|Д) ;; *) CHOSEN="" ;; esac
    fi
    SU=""; for i in $CHOSEN; do [ "${C_SUDO[i]}" = 1 ] && SU="$SU $i"; done
    if [ -n "$CHOSEN" ] && [ -n "$SU" ]; then
      section "Cleanup"; info 'These steps need your Mac password:'
      for i in $SU; do lines "$(sudo_cmds "${C_PATHS[i]#orph:}")"; done
      if ! { printf '%s' "$CL"; sudo -v -p "  $(_ 'Mac password to remove system leftovers:') "; }; then
        warn 'Password not accepted, system items skipped'
        CHOSEN=$(for i in $CHOSEN; do [ "${C_SUDO[i]}" = 1 ] || echo "$i"; done)
      fi
    fi
    if [ -n "$CHOSEN" ]; then section "Cleanup"; for i in $CHOSEN; do exec_cand "$i"; done; fi
    [ -n "$SU" ] && sudo -k
  fi
fi

# ================================================================ TRENDS + SUMMARY
FREE_AFTER=$(df -k /System/Volumes/Data 2>/dev/null | awk 'NR==2{print $4}'); FREE_AFTER=${FREE_AFTER:-0}
PCT2=$(( FREE_AFTER * 100 / D_TOTAL ))

if task check.trends && [ -n "$PREV" ]; then
  section "Since last run"
  IFS=, read -r P_TS P_MODE P_FREE P_TOT P_MEM P_SWAP P_CYC P_MAX P_UPD P_FREED P_WARN <<EOF
$PREV
EOF
  DFREE=$((FREE_AFTER - ${P_FREE:-$FREE_AFTER}))
  # swap files take disk space and macOS deletes them on restart: growing swap is not something filling the disk
  DSWAP=0
  case "$P_SWAP" in ''|*[!0-9]*) ;; *) [ "$SWAP_OK" = 1 ] && [ "$DFREE" -lt 0 ] && DSWAP=$(( (SWAP - P_SWAP) * 1024 )) ;; esac
  [ "$DSWAP" -lt 0 ] && DSWAP=0
  [ "$DSWAP" -gt $((-DFREE)) ] && [ "$DSWAP" -gt 0 ] && DSWAP=$((-DFREE))
  if [ "$DSWAP" -ge 1048576 ]; then
    if [ $((DFREE + DSWAP)) -lt -20971520 ]; then warn 'Free space: %s since %s (%s of it is swap, freed on restart) — something is filling the disk (try: macup check --deep)' "$(hum "$DFREE")" "$P_TS" "$(hum "$DSWAP")"
    else info 'Free space: %s since %s (%s of it is swap, freed on restart)' "$(hum "$DFREE")" "$P_TS" "$(hum "$DSWAP")"; fi
  elif [ $((DFREE + DSWAP)) -lt -20971520 ]; then warn 'Free space: %s since %s — something is filling the disk (try: macup check --deep)' "$(hum "$DFREE")" "$P_TS"
  else info 'Free space: %s since %s' "$( [ "$DFREE" -ge 0 ] && printf '+')$(hum "$DFREE")" "$P_TS"; fi
  [ -n "$BMAX" ] && [ -n "$P_MAX" ] && [ "$P_MAX" != "$BMAX" ] && info 'Battery capacity: %s%% → %s%%' "$P_MAX" "$BMAX"
  [ -n "$BCYC" ] && [ -n "$P_CYC" ] && [ "$P_CYC" != "$BCYC" ] && info 'Battery cycles: +%s' "$((BCYC - P_CYC))"
  info 'Full history: macup history'
fi

NEWER=""
if task check.self_update; then
  case "$MACUP_REPO" in __*) ;; *)
    STAMPF="$STATE_DIR/last_version_check"
    if [ ! -f "$STAMPF" ] || [ -n "$(find "$STAMPF" -mtime +6 2>/dev/null)" ]; then
      RV=$(curl -fsS --max-time 4 "$MACUP_RAW/main/macup" 2>/dev/null | sed -n 's/^MACUP_VERSION="\(.*\)"/\1/p' | head -1)
      if [ -n "$RV" ]; then echo "$RV" >"$STAMPF"; else touch "$STAMPF"; fi
    fi
    RV=$(cat "$STAMPF" 2>/dev/null)
    ver_gt "$RV" "$MACUP_VERSION" && NEWER="$RV"
  ;; esac
fi

T=$SECONDS; TIME="$((T / 60))m $((T % 60))s"
echo "$(date '+%Y-%m-%d %H:%M'),$MODE,$FREE_AFTER,$D_TOTAL,${MEMFREE:-},${SWAP:-0},${BCYC:-},${BMAX:-},${#UPDATED[@]},$FREED,${#WARN[@]}" >>"$HISTORY"

SUM=$(mktemp "${TMPDIR:-/tmp}/macup.XXXXXX")
{
  echo "# $(_f 'macup report — %s' "$(date '+%Y-%m-%d %H:%M')")"
  echo
  _f 'Mode: %s · macup %s · took %s' "$MODE" "$MACUP_VERSION" "$TIME"; echo
  echo
  echo "## $(_ 'Summary')"
  echo
  if [ ${#UPDATED[@]} -gt 0 ]; then echo "- **$(_f 'Updated (%s):' "${#UPDATED[@]}")**"; for u in "${UPDATED[@]}"; do echo "    - $u"; done
  elif UPD; then echo "- $(_ 'Updates: everything was already up to date')"; fi
  if CLEAN || [ "$DID_CLEAN" = 1 ]; then echo "- **$(_f 'Freed: %s' "$(hum "$FREED")")**"
  elif WANT_CLN && [ "$POT_AUTO" -gt 0 ]; then echo "- $(_f 'Could free: ~%s' "$(hum "$POT_AUTO")")"; fi
  if [ ${#SKIPPED[@]} -gt 0 ]; then echo "- **$(_f 'Skipped because the app is open (%s), quit it and run again:' "${#SKIPPED[@]}")**"; for s in "${SKIPPED[@]}"; do echo "    - $s"; done; fi
  WANT_CLN && [ "$DID_CLEAN" = 0 ] && [ "$POT_MORE" -gt 0 ] && echo "- $(_f 'More with a higher level or by picking: ~%s' "$(hum "$POT_MORE")")"
  echo "- $(_f 'Free disk space: %s (%s%%), was %s' "$(hum "$FREE_AFTER")" "$PCT2" "$(hum "$FREE_BEFORE")")"
  if [ ${#WARN[@]} -gt 0 ]; then echo "- **$(_f 'Needs attention (%s):' "${#WARN[@]}")**"; for w in "${WARN[@]}"; do echo "    - $w"; done
  else echo "- $(_ 'Needs attention: nothing')"; fi
  [ -n "$NEWER" ] && echo "- $(_f 'macup %s is available: %s' "$NEWER" "$(update_cmd)")"
} >"$SUM"
{ cat "$SUM" "$BODY"; raw_section; } >"$REPORT"; rm -f "$SUM"; REPORT_DONE=1

[ "$QUIET" = 1 ] && exec >&3 3>&-
if [ "$JSON" = 1 ]; then
  # schema grows by adding fields; a change that breaks a reader raises the number
  # "log" stays for older readers: the command output is at the end of the report now, so it names the report
  json_items(){ local i; printf '['; for ((i = 0; i < IT_N; i++)); do [ $i = 0 ] || printf ','
    printf '{"section":"%s","kind":"%s","text":"%s","details":%s}' "$(jstr "${IT_SEC[i]}")" "${IT_KIND[i]}" "$(jstr "${IT_MSG[i]}")" "$(jlines "$(awk -F'\t' -v i="$i" '$1 == i { sub(/^[^\t]*\t/, ""); print }' "$BODY.det" 2>/dev/null)")"; done; printf ']'; }
  json_cands(){ local i first=1 lv inc opt hid busy; printf '['
    # every candidate, the small ones the terminal list hides too: a program can still --pick them
    [ "$DRY" = 1 ] && for ((i = 0; i < ${C_N:-0}; i++)); do
      [ $first = 1 ] || printf ','; first=0
      case "${C_LVL[i]}" in 1) lv=safe ;; 2) lv=standard ;; *) lv=aggressive ;; esac
      opt=true; inc=false; [ "${C_AUTO[i]}" = 1 ] && { opt=false; [ "${C_LVL[i]}" -le "$LEVEL" ] && inc=true; }
      hid=true; visible "$i" && hid=false
      busy=false; [ "${C_BUSY[i]:-0}" = 1 ] && busy=true
      printf '{"key":"%s","task":"%s","level":"%s","kb":%s,"opt_in":%s,"in_clean":%s,"hidden":%s,"busy":%s,"text":"%s"}' "${C_KEY[i]}" "${C_TASK[i]}" "$lv" "${C_KB[i]:-0}" "$opt" "$inc" "$hid" "$busy" "$(jstr "${C_LBL[i]}")"
    done; printf ']'; }
  printf '{"schema":1,"version":"%s","mode":"%s","date":"%s","seconds":%s,"free_kb":%s,"total_kb":%s,"freed_kb":%s,"could_free_kb":%s,"could_free_more_kb":%s,' \
    "$MACUP_VERSION" "$MODE" "$(date '+%Y-%m-%d %H:%M')" "$T" "$FREE_AFTER" "$D_TOTAL" "$FREED" "${POT_AUTO:-0}" "${POT_MORE:-0}"
  printf '"updated":%s,"skipped_open":%s,"needs_attention":%s,"failed_steps":%s,"newer_macup":"%s","report":"%s","log":"%s","items":%s,"cleanable":%s}\n' \
    "$(jarr "${UPDATED[@]}")" "$(jarr "${SKIPPED[@]}")" "$(jarr "${WARN[@]}")" "$ERRS" "$NEWER" "$(jstr "$REPORT")" "$(jstr "$REPORT")" "$(json_items)" "$(json_cands)"
else
printf '%s\n%s━━━━━━━━━━━━━━━━ %s ━━━━━━━━━━━━━━━━%s\n' "$CL" "$B" "$(_ 'Summary')" "$N"
if [ ${#UPDATED[@]} -gt 0 ]; then
  printf '  %s%s%s\n' "$G" "$(_f 'Updated: %s' "${#UPDATED[@]}")" "$N"; for u in "${UPDATED[@]}"; do printf '    · %s\n' "$u"; done
elif UPD; then printf '  %s%s%s\n' "$G" "$(_ 'Updates: everything was already up to date')" "$N"; fi
if CLEAN || [ "$DID_CLEAN" = 1 ]; then printf '  %s%s%s\n' "$G" "$(_f 'Freed: %s' "$(hum "$FREED")")" "$N"
elif WANT_CLN && [ "$POT_AUTO" -gt 0 ]; then printf '  %s\n' "$(_f 'Could free: ~%s  (to free it: macup all)' "$(hum "$POT_AUTO")")"; fi
if [ ${#SKIPPED[@]} -gt 0 ]; then
  printf '  %s%s%s\n' "$Y" "$(_f 'Skipped because the app is open (%s), quit it and run again:' "${#SKIPPED[@]}")" "$N"; for s in "${SKIPPED[@]}"; do printf '    · %s\n' "$s"; done
fi
WANT_CLN && [ "$DID_CLEAN" = 0 ] && [ "$POT_MORE" -gt 0 ] && printf '  %s\n' "$(_f 'More with a higher level or by picking: ~%s' "$(hum "$POT_MORE")")"
printf '  %s\n' "$(_f 'Free disk space: %s (%s%%)' "$(hum "$FREE_AFTER")" "$PCT2")"
if [ ${#WARN[@]} -gt 0 ]; then
  printf '  %s%s%s\n' "$Y" "$(_f 'Needs attention: %s' "${#WARN[@]}")" "$N"; for w in "${WARN[@]}"; do printf '    %s!%s %s\n' "$Y" "$N" "$w"; done
else printf '  %s%s%s\n' "$G" "$(_ 'Needs attention: nothing')" "$N"; fi
[ -n "$NEWER" ] && printf '  %s%s%s\n' "$C" "$(_f 'macup %s is available: %s' "$NEWER" "$(update_cmd)")" "$N"
printf '  %s%s%s\n' "$D" "$(_f 'Report: %s · %s' "$(tildify "$REPORT")" "$TIME")" "$N"
printf '  %s%s%s\n' "$D" "$(_ 'Menu: macup · trends: macup history · help: macup help')" "$N"
fi

# --notify (the schedule uses it): one notification when something needs a look
# nothing to say, no notification: a weekly "all good" teaches people to ignore it
if [ "$NOTIFY" = 1 ] && command -v osascript >/dev/null 2>&1 && { [ ${#WARN[@]} -gt 0 ] || [ "${POT_AUTO:-0}" -ge 1048576 ]; }; then
  if [ ${#WARN[@]} -gt 0 ]; then NT=$(_f 'Needs attention: %s' "${#WARN[@]}"); else NT=$(_ 'Needs attention: nothing'); fi
  [ "${POT_AUTO:-0}" -ge 1048576 ] && NT="$NT · $(_f 'Could free: ~%s' "$(hum "$POT_AUTO")")"
  osascript -e "display notification \"$(jstr "$NT. $(_ 'Details: macup last')")\" with title \"macup\"" >/dev/null 2>&1
fi
# 3: an update or cleanup step failed. Warnings from the health checks are not failures of the run.
[ "$ERRS" -gt 0 ] && exit 3
exit 0
